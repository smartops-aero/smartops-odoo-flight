<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Import Wizard Form View -->
    <record id="view_import_wizard_form" model="ir.ui.view">
        <field name="name">import.wizard.form</field>
        <field name="model">import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Data">
                <sheet>
                    <group>
                        <field name="pipeline_id"/>
                        <field name="delimiter"/>
                        <field name="file" filename="filename" widget="binary"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <p class="text-muted">
                        <strong>Note:</strong> The file should be in CSV format and contain the necessary fields for the selected import pipeline.
                    </p>
                </sheet>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Data</field>
        <field name="res_model">import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
