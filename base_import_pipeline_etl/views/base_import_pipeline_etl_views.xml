<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ETL Pipeline Form View -->
    <record id="view_base_import_pipeline_form" model="ir.ui.view">
        <field name="name">base.import.pipeline.form</field>
        <field name="model">base.import.pipeline</field>
        <field name="inherit_id" ref="base_import_pipeline.view_base_import_pipeline_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Field Mappings">
                    <field name="mapping_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="source_field"/>
                            <field name="model_id"/>
                            <field name="target_field"/>
                            <field name="transformation"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
