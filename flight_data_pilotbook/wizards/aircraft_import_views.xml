<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aircraft Import Wizard Form View -->
    <record id="view_flight_aircraft_import_wizard_form" model="ir.ui.view">
        <field name="name">flight.aircraft.import.wizard.form</field>
        <field name="model">flight.aircraft.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Aircraft">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="upload,preview,import"/>
                </header>
                <sheet>
                    <!-- Upload State -->
                    <div attrs="{'invisible': [('state', '!=', 'upload')]}">
                        <div class="alert alert-info" role="alert">
                            <p>This wizard will import aircraft from a CSV file.</p>
                            <p>The CSV file should have the following headers: Registration, Model, Operator, Equipment Type, Engine Type, Category</p>
                            <p>If your CSV uses different header names, you can adjust the field mapping below.</p>
                        </div>
                        <group>
                            <group>
                                <field name="csv_file" widget="binary" filename="filename" placeholder="Upload CSV file"/>
                                <field name="filename" invisible="1"/>
                                <field name="delimiter"/>
                            </group>
                            <group string="Field Mapping">
                                <field name="registration_field"/>
                                <field name="model_field"/>
                                <field name="operator_field"/>
                                <field name="equipment_type_field"/>
                                <field name="engine_type_field"/>
                                <field name="category_field"/>
                            </group>
                        </group>
                    </div>
                    
                    <!-- Preview State -->
                    <div attrs="{'invisible': [('state', '!=', 'preview')]}">
                        <group>
                            <group>
                                <field name="total_rows"/>
                                <field name="valid_count"/>
                            </group>
                            <group>
                                <field name="invalid_count"/>
                                <field name="conflict_count"/>
                            </group>
                        </group>
                        <div class="alert alert-info" role="alert" attrs="{'invisible': [('valid_count', '=', 0)]}">
                            There are <field name="valid_count" class="oe_inline"/> valid records ready to be imported.
                        </div>
                        <div class="alert alert-danger" role="alert" attrs="{'invisible': [('invalid_count', '=', 0)]}">
                            There are <field name="invalid_count" class="oe_inline"/> invalid records that cannot be imported.
                        </div>
                        <div class="alert alert-warning" role="alert" attrs="{'invisible': [('conflict_count', '=', 0)]}">
                            There are <field name="conflict_count" class="oe_inline"/> conflicts detected. Review the conflicts and check the "Import" toggle button for those you want to update.
                        </div>
                    </div>
                    
                    <!-- Import Complete State -->
                    <div attrs="{'invisible': [('state', '!=', 'import')]}">
                        <div class="alert alert-success" role="alert">
                            Import completed successfully!
                        </div>
                        <group>
                            <group>
                                <field name="imported_count" string="Imported"/>
                            </group>
                            <group>
                                <field name="skipped_count" string="Skipped"/>
                            </group>
                        </group>
                    </div>
                    
                    <field name="line_ids" attrs="{'invisible': [('state', '=', 'upload')]}">
                        <tree editable="bottom" decoration-danger="status=='invalid'" decoration-warning="status=='conflict'" decoration-success="status=='valid'">
                            <field name="registration"/>
                            <field name="model"/>
                            <field name="operator"/>
                            <field name="equipment_type"/>
                            <field name="engine_type"/>
                            <field name="category"/>
                            <field name="to_import" widget="boolean_toggle" attrs="{'invisible': [('parent.state', '=', 'import')]}"/>
                            <field name="status" attrs="{'invisible': [('parent.state', '=', 'import')]}"/>
                            <field name="message" attrs="{'invisible': [('parent.state', '=', 'import')]}"/>
                            <field name="result" attrs="{'invisible': [('parent.state', '!=', 'import')]}"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_parse_file" string="Preview" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'upload')]}"/>
                    <button name="action_import" string="Import" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'preview')]}"/>
                    <button name="action_reset" string="Import Another File" type="object" class="btn-secondary" attrs="{'invisible': [('state', '!=', 'import')]}"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Aircraft Import Wizard Action -->
    <record id="action_flight_aircraft_import" model="ir.actions.act_window">
        <field name="name">Import Aircraft</field>
        <field name="res_model">flight.aircraft.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
