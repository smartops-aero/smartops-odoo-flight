<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Flight Import Line Form View -->
    <record id="view_flight_import_line_form" model="ir.ui.view">
        <field name="name">flight.import.line.form</field>
        <field name="model">flight.import.line</field>
        <field name="arch" type="xml">
            <form string="Flight Import Line">
                <group>
                    <group>
                        <field name="to_import"/>
                        <field name="status"/>
                        <field name="message" attrs="{'invisible': [('message', '=', False)]}"/>
                        <field name="result" attrs="{'invisible': [('result', '=', False)]}"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="flight_number"/>
                        <field name="departure_id"/>
                        <field name="arrival_id"/>
                        <field name="aircraft_id"/>
                        <field name="flight_time"/>
                        <field name="is_simulator"/>
                    </group>
                </group>
                <group string="Raw Data">
                    <group>
                        <field name="raw_date"/>
                        <field name="raw_flight_number"/>
                        <field name="raw_departure"/>
                        <field name="raw_arrival"/>
                    </group>
                    <group>
                        <field name="raw_aircraft_reg"/>
                        <field name="raw_aircraft_make"/>
                        <field name="raw_aircraft_model"/>
                        <field name="raw_flight_time"/>
                        <field name="raw_is_simulator"/>
                    </group>
                </group>
                <group string="Remarks">
                    <field name="remarks" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Flight Import Line Tree View -->
    <record id="view_flight_import_line_tree" model="ir.ui.view">
        <field name="name">flight.import.line.tree</field>
        <field name="model">flight.import.line</field>
        <field name="arch" type="xml">
            <tree string="Flight Import Lines" create="0" delete="0" editable="bottom">
                <field name="to_import" widget="boolean_toggle"/>
                <field name="status" decoration-success="status == 'valid'" 
                       decoration-danger="status == 'invalid'" 
                       decoration-warning="status == 'conflict'"/>
                <field name="date"/>
                <field name="departure_id"/>
                <field name="arrival_id"/>
                <field name="aircraft_id"/>
                <field name="flight_time" sum="Total"/>
                <field name="is_simulator"/>
                <field name="message"/>
                <field name="result"/>
            </tree>
        </field>
    </record>

    <!-- Flight Import Wizard Form View -->
    <record id="view_flight_import_form" model="ir.ui.view">
        <field name="name">flight.import.form</field>
        <field name="model">flight.import</field>
        <field name="arch" type="xml">
            <form string="Import Flights">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="upload,preview,import"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" attrs="{'invisible': [('state', '!=', 'upload')]}">
                        <p>Upload a CSV file containing flight data.</p>
                        <p>The CSV file should have headers matching the field names below.</p>
                    </div>
                    
                    <div class="alert alert-info" role="alert" attrs="{'invisible': [('state', '!=', 'preview')]}">
                        <p>Review the imported data below. You can toggle the 'Import' checkbox to select which flights to import.</p>
                        <p>Click 'Import Flights' to proceed with the import or 'Reset' to start over.</p>
                    </div>
                    
                    <div class="alert alert-success" role="alert" attrs="{'invisible': [('state', '!=', 'import')]}">
                        <p>Import completed successfully!</p>
                        <p>Summary: <field name="imported_count" class="oe_inline"/> flights imported, <field name="skipped_count" class="oe_inline"/> skipped.</p>
                    </div>
                    
                    <!-- Upload state -->
                    <group attrs="{'invisible': [('state', '!=', 'upload')]}">
                        <group>
                            <field name="csv_file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="delimiter"/>
                        </group>
                        <group>
                            <field name="date_field"/>
                            <field name="flight_number_field"/>
                            <field name="departure_field"/>
                            <field name="arrival_field"/>
                        </group>
                        <group>
                            <field name="aircraft_reg_field"/>
                            <field name="aircraft_make_field"/>
                            <field name="aircraft_model_field"/>
                        </group>
                        <group>
                            <field name="remarks_field"/>
                            <field name="pilot1_field"/>
                            <field name="pilot2_field"/>
                            <field name="flight_time_field"/>
                            <field name="is_simulator_field"/>
                        </group>
                    </group>
                    
                    <!-- Preview and Import states -->
                    <group attrs="{'invisible': [('state', '=', 'upload')]}">
                        <group>
                            <field name="total_rows"/>
                            <field name="valid_count"/>
                            <field name="invalid_count"/>
                        </group>
                        <group>
                            <field name="conflict_count"/>
                            <field name="imported_count"/>
                            <field name="skipped_count"/>
                        </group>
                    </group>
                    
                    <field name="line_ids" attrs="{'invisible': [('state', '=', 'upload')]}">
                        <tree>
                            <field name="to_import" widget="boolean_toggle"/>
                            <field name="status" decoration-success="status == 'valid'" 
                                   decoration-danger="status == 'invalid'" 
                                   decoration-warning="status == 'conflict'"/>
                            <field name="date"/>
                            <field name="departure_id"/>
                            <field name="arrival_id"/>
                            <field name="aircraft_id"/>
                            <field name="flight_time" sum="Total"/>
                            <field name="is_simulator"/>
                            <field name="message"/>
                            <field name="result"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_preview" string="Preview" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'upload')]}"/>
                    <button name="action_import" string="Import Flights" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'preview')]}"/>
                    <button name="action_reset" string="Reset" type="object" class="btn-secondary" attrs="{'invisible': [('state', '=', 'upload')]}"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Flight Import Action -->
    <record id="action_flight_import" model="ir.actions.act_window">
        <field name="name">Import Flights</field>
        <field name="res_model">flight.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
