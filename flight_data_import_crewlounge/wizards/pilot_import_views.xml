<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pilot Import Form View -->
    <record id="view_flight_data_import_crewlounge_pilot_form" model="ir.ui.view">
        <field name="name">flight.data.import.crewlounge.pilot.form</field>
        <field name="model">flight.data.import.crewlounge.pilot</field>
        <field name="arch" type="xml">
            <form string="Import Pilots from CrewLounge">
                <sheet>
                    <div states="draft">
                        <group>
                            <field name="import_file" filename="filename" required="1"/>
                            <field name="filename" invisible="1"/>
                            <field name="file_format"/>
                            <field name="has_header"/>
                            <field name="csv_delimiter" attrs="{'invisible': [('file_format', 'not in', ['auto', 'csv'])]}"/>
                            <field name="csv_quotechar" attrs="{'invisible': [('file_format', 'not in', ['auto', 'csv'])]}"/>
                        </group>
                        <footer>
                            <button name="action_import_file" string="Preview" type="object" class="btn-primary"/>
                            <button special="cancel" string="Cancel" class="btn-secondary"/>
                        </footer>
                    </div>
                    <div states="preview,done">
                        <group>
                            <field name="state" invisible="1"/>
                            <field name="statistics" readonly="1"/>
                            <field name="total_rows" readonly="1"/>
                            <field name="valid_rows" readonly="1"/>
                            <field name="invalid_rows" readonly="1"/>
                            <field name="conflict_rows" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Import Lines">
                                <field name="import_line_ids" readonly="0">
                                    <tree decoration-success="state == 'valid'" 
                                          decoration-warning="state == 'conflict'" 
                                          decoration-danger="state == 'invalid'" 
                                          decoration-info="state == 'imported'">
                                        <field name="to_import" widget="boolean_toggle"/>
                                        <field name="state" invisible="1"/>
                                        <field name="row_index"/>
                                        <field name="company_name"/>
                                        <field name="employee_id"/>
                                        <field name="name"/>
                                        <field name="email"/>
                                        <field name="phone"/>
                                        <field name="is_new"/>
                                        <field name="error_message"/>
                                        <field name="warning_message"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <footer>
                            <button name="action_import" string="Import Selected" type="object" class="btn-primary" states="preview"/>
                            <button name="action_reset" string="Reset" type="object" class="btn-secondary"/>
                            <button special="cancel" string="Close" class="btn-secondary"/>
                        </footer>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pilot Import Line Form View -->
    <record id="view_flight_data_import_crewlounge_pilot_line_form" model="ir.ui.view">
        <field name="name">flight.data.import.crewlounge.pilot.line.form</field>
        <field name="model">flight.data.import.crewlounge.pilot.line</field>
        <field name="arch" type="xml">
            <form string="Pilot Import Line">
                <sheet>
                    <group>
                        <group>
                            <field name="state" readonly="1"/>
                            <field name="to_import"/>
                            <field name="row_index" readonly="1"/>
                            <field name="raw_data" readonly="1"/>
                            <field name="error_message" readonly="1" attrs="{'invisible': [('error_message', '=', False)]}"/>
                            <field name="warning_message" readonly="1" attrs="{'invisible': [('warning_message', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="company_name"/>
                            <field name="company_id"/>
                            <field name="employee_id"/>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="notes"/>
                            <field name="is_new"/>
                            <field name="partner_id" attrs="{'invisible': [('is_new', '=', True)]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pilot Import Action -->
    <record id="action_flight_data_import_crewlounge_pilot" model="ir.actions.act_window">
        <field name="name">Import Pilots from CrewLounge</field>
        <field name="res_model">flight.data.import.crewlounge.pilot</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_flight_data_import_crewlounge_pilot" 
              name="Import from CrewLounge" 
              parent="flight_data_import.menu_crew_import"
              action="action_flight_data_import_crewlounge_pilot" 
              sequence="10"/>
</odoo>
