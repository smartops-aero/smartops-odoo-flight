<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Aircraft Import Form View -->
    <record id="view_flight_data_import_crewlounge_aircraft_form" model="ir.ui.view">
        <field name="name">flight.data.import.crewlounge.aircraft.form</field>
        <field name="model">flight.data.import.crewlounge.aircraft</field>
        <field name="arch" type="xml">
            <form string="Import Aircraft">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,preview,done" />
                </header>
                <sheet>
                    <!-- File Upload Section (Draft State) -->
                    <group attrs="{'invisible': [('state', 'not in', ['draft'])]}">
                        <field name="import_file" filename="filename" required="1"/>
                        <field name="filename" invisible="1"/>
                        <field name="file_format"/>
                        <field name="has_header"/>
                        <field name="csv_delimiter" attrs="{'invisible': [('file_format', 'not in', ['auto', 'csv'])]}"/>
                        <field name="csv_quotechar" attrs="{'invisible': [('file_format', 'not in', ['auto', 'csv'])]}"/>
                    </group>
                    
                    <!-- Preview and Import Section (Preview/Done States) -->
                    <group attrs="{'invisible': [('state', 'not in', ['preview', 'done'])]}">
                        <group>
                            <field name="total_rows" readonly="1"/>
                            <field name="valid_rows" readonly="1"/>
                            <field name="invalid_rows" readonly="1"/>
                            <field name="conflict_rows" readonly="1"/>
                        </group>
                        <group>
                            <field name="update_existing" attrs="{'readonly': [('state', '!=', 'preview')]}" />
                        </group>
                    </group>
                    
                    <notebook attrs="{'invisible': [('state', 'not in', ['preview', 'done'])]}">
                        <page string="Import Lines">
                            <field name="import_line_ids" readonly="0">
                                <tree decoration-success="state == 'valid'" 
                                      decoration-warning="state == 'conflict'" 
                                      decoration-danger="state == 'invalid'" 
                                      decoration-info="state == 'imported'">
                                    <field name="state" invisible="1" />
                                    <field name="reference" />
                                    <field name="ac" />
                                    <field name="dev" />
                                    <field name="cat" />
                                    <field name="company_name" />
                                    <field name="pw" />
                                    <field name="wt" />
                                    <field name="is_new" />
                                    <field name="error_message" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <!-- Draft State Buttons -->
                    <button name="action_import_file" string="Preview" type="object" 
                            class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    
                    <!-- Preview State Buttons -->
                    <button name="action_import" string="Import" type="object" 
                            class="btn-primary" attrs="{'invisible': [('state', '!=', 'preview')]}"/>
                    <button name="action_reset" string="Reset" type="object" 
                            class="btn-secondary" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    
                    <!-- Always Visible Buttons -->
                    <button special="cancel" string="Cancel" class="btn-secondary" 
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button special="cancel" string="Close" class="btn-secondary" 
                            attrs="{'invisible': [('state', '=', 'draft')]}"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Aircraft Import Line Form View -->
    <record id="view_flight_data_import_crewlounge_aircraft_line_form" model="ir.ui.view">
        <field name="name">flight.data.import.crewlounge.aircraft.line.form</field>
        <field name="model">flight.data.import.crewlounge.aircraft.line</field>
        <field name="arch" type="xml">
            <form string="Aircraft Import Line">
                <sheet>
                    <div class="alert alert-danger" role="alert" attrs="{'invisible': [('error_message', '=', False)]}">
                        <field name="error_message" />
                    </div>
                    <group>
                        <group>
                            <field name="state" readonly="1"/>
                            <field name="raw_data" readonly="1"/>
                            <field name="error_message" readonly="1" attrs="{'invisible': [('error_message', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="reference" />
                            <field name="ac" />
                            <field name="dev" />
                            <field name="cat" />
                            <field name="company_name" />
                            <field name="pw" />
                            <field name="wt" />
                            <field name="is_new" />
                            <field name="aircraft_id" attrs="{'invisible': [('aircraft_id', '=', False)]}" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Aircraft Import Action -->
    <record id="action_flight_data_import_crewlounge_aircraft" model="ir.actions.act_window">
        <field name="name">Import Aircraft</field>
        <field name="res_model">flight.data.import.crewlounge.aircraft</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
