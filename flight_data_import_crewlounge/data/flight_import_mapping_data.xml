        <record id="flight_import_mapping_flight_date" model="flight.import.mapping">
            <field name="template_id" ref="flight_import_template_crewlounge_pilotlog"/>
            <field name="model_id" ref="flight.model_flight_flight"/>
            <field name="field_id" ref="flight.field_flight_flight__date"/>
            <field name="source_field">PILOTLOG_DATE</field>
            <field name="transform_type">function</field>
            <field name="transform_function">_parse_date</field>
            <field name="is_required" eval="True"/>
            <field name="is_identifier" eval="True"/>
            <field name="sequence">10</field>
        </record>
        
