<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- CrewLounge PILOTLOG Import Template -->
        <record id="flight_import_template_crewlounge_pilotlog" model="flight.import.template">
            <field name="name">CrewLounge PILOTLOG</field>
            <field name="source_format">crewlounge_pilotlog</field>
            <field name="description">Import template for CrewLounge PILOTLOG CSV format</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- Model Processing Sequence -->
        <record id="flight_import_model_sequence_flight" model="flight.import.model.sequence">
            <field name="template_id" ref="flight_import_template_crewlounge_pilotlog"/>
            <field name="model_id" ref="flight.model_flight_flight"/>
            <field name="sequence">10</field>
        </record>
        
        <record id="flight_import_model_sequence_pilot_time" model="flight.import.model.sequence">
            <field name="template_id" ref="flight_import_template_crewlounge_pilotlog"/>
            <field name="model_id" ref="flight_pilotlog.model_flight_pilot_time"/>
            <field name="sequence">20</field>
        </record>
        
        <record id="flight_import_model_sequence_pilot_event" model="flight.import.model.sequence">
            <field name="template_id" ref="flight_import_template_crewlounge_pilotlog"/>
            <field name="model_id" ref="flight_pilotlog.model_flight_pilot_event"/>
            <field name="sequence">30</field>
        </record>
    </data>
</odoo>
