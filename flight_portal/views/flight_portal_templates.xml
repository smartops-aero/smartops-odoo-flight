<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
    id="portal_my_home_flight"
    name="Portal My Home : flight entries"
    inherit_id="portal.portal_my_home"
    priority="40"
  >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Flights</t>
                <t t-set="url" t-value="'/my/flights'" />
                <t t-set="placeholder_count" t-value="'flight_count'" />
            </t>
        </xpath>
    </template>

    <template id="portal_my_flights" name="My Flights">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Flights</t>
            </t>
            <t t-if="not flights">
                <div class="alert alert-warning mt8" role="alert">
                    There are no flights.
                </div>
            </t>
            <t t-if="flights" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Flight Date</th>
                        <th>Aircraft</th>
                        <th>Departure</th>
                        <th>Arrival</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="flights" t-as="flight">
                        <tr>
                            <td>
                                <a
                  t-attf-href="/my/flight/#{flight.id}"
                  t-out="flight.date"
                />
                            </td>
                            <td t-out="flight.aircraft_id.registration" />
                            <td t-out="flight.departure_id.name" />
                            <td t-out="flight.arrival_id.name" />
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_flight_page" name="Flight Portal Page">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" groups="portal.group_portal">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t
            t-set="backend_url"
            t-value="'/web#model=flight.flight&amp;id=%s&amp;view_type=form' % (flight.id)"
          />
                </t>
            </t>

            <t t-call="portal.portal_record_layout">
                <t t-set="card_header">
                    <h5 class="mb-0">
                        <small class="text-muted">Flight Details</small>
                    </h5>
                </t>
                <t t-set="card_body">
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <strong>Flight Date:</strong>
                            <span t-field="flight.date" />
                        </div>
                        <div class="col-12 col-md-6">
                            <strong>Aircraft:</strong>
                            <span t-field="flight.aircraft_id.registration" />
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-12 col-md-6">
                            <strong>Departure:</strong>
                            <span t-field="flight.departure_id.name" />
                        </div>
                        <div class="col-12 col-md-6">
                            <strong>Arrival:</strong>
                            <span t-field="flight.arrival_id.name" />
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template
    id="portal_breadcrumbs"
    name="Portal Breadcrumbs"
    inherit_id="portal.portal_breadcrumbs"
  >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'flight'" class="breadcrumb-item">
                <a t-if="flight" t-attf-href="/my/flights">Flights</a>
                <t t-else="">Flights</t>
            </li>
            <li t-if="flight" class="breadcrumb-item active">
                <t t-out="flight.display_name" />
            </li>
        </xpath>
    </template>
</odoo>
