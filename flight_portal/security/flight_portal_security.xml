<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="flight_portal_rule" model="ir.rule">
        <field name="name">Portal Flight Access</field>
        <field name="model_id" ref="flight.model_flight_flight" />
        <field
      name="domain_force"
    >[('message_partner_ids', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
    </record>
</odoo>
