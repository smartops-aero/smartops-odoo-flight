<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Existing rule -->
        <record id="flight_aircraft_public" model="ir.rule">
            <field name="name">Public Aircraft</field>
            <field name="model_id" ref="flight.model_flight_aircraft" />
            <field
        name="domain_force"
      >[('website_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public'))]" />
        </record>

        <!-- Aircraft Model -->
        <record id="flight_aircraft_model_public" model="ir.rule">
            <field name="name">Public Aircraft Model</field>
            <field name="model_id" ref="flight.model_flight_aircraft_model" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_public'))]" />
        </record>

        <!-- Aircraft Make -->
        <record id="flight_aircraft_make_public" model="ir.rule">
            <field name="name">Public Aircraft Make</field>
            <field name="model_id" ref="flight.model_flight_aircraft_make" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_public'))]" />
        </record>

        <!-- Aircraft Class -->
        <record id="flight_aircraft_class_public" model="ir.rule">
            <field name="name">Public Aircraft Class</field>
            <field name="model_id" ref="flight.model_flight_aircraft_class" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_public'))]" />
        </record>

        <!-- Aircraft Model Tag -->
        <record id="flight_aircraft_model_tag_public" model="ir.rule">
            <field name="name">Public Aircraft Model Tag</field>
            <field
        name="model_id"
        ref="flight.model_flight_aircraft_model_tag"
      />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_public'))]" />
        </record>

        <!-- Aircraft Amenity -->
        <record id="flight_aircraft_amenity_public" model="ir.rule">
            <field name="name">Public Aircraft Amenity</field>
            <field name="model_id" ref="model_flight_aircraft_amenity" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_public'))]" />
        </record>
    </data>
</odoo>
