<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- ====== Aircraft Form Views ====== -->
  <record id="aircraft_view_form_add" model="ir.ui.view">
    <field name="name">flight.aircraft.view.form.add</field>
    <field name="model">flight.aircraft</field>
    <field name="arch" type="xml">
      <form js_class="website_new_content_form">
        <sheet>
          <!-- Basic Information Section -->
          <group name="basic_info">
            <group>
              <field name="website_url" invisible="1" />
              <field
                name="registration"
                placeholder="Aircraft Registration"
                required="1"
              />
              <field
                name="model_id"
                placeholder="Aircraft Model"
                required="1"
              />
              <field
                name="website_display_name"
                placeholder="Name displayed on website (e.g. Citation Bravo N550RM)"
              />
              <field
                name="website_aircraft_slogan"
                placeholder="Aircraft slogan or tagline"
              />
              <field
                name="website_short_description"
                placeholder="Short description displayed on cards and detail page"
              />
            </group>
          </group>

          <notebook>
            <!-- Specifications Tab -->
            <page string="Specifications" name="specifications">
              <group>
                <group string="Capacity">
                  <field
                    name="passenger_capacity"
                    placeholder="Number of passengers"
                  />
                  <label for="luggage_capacity" string="Luggage Capacity"/>
                  <div class="o_row">
                    <field name="luggage_capacity" class="oe_inline"/>
                    <field name="luggage_capacity_uom_id" class="oe_inline"/>
                  </div>
                  <label for="useful_load" string="Useful Load"/>
                  <div class="o_row">
                    <field name="useful_load" class="oe_inline"/>
                    <field name="useful_load_uom_id" class="oe_inline"/>
                  </div>
                </group>
                <group string="Performance">
                  <label for="range" string="Range"/>
                  <div class="o_row">
                    <field name="range" class="oe_inline"/>
                    <field name="range_uom_id" class="oe_inline"/>
                  </div>
                  <label for="cruise_speed" string="Cruise Speed"/>
                  <div class="o_row">
                    <field name="cruise_speed" class="oe_inline"/>
                    <field name="cruise_speed_uom_id" class="oe_inline"/>
                  </div>
                </group>
                <group string="Cabin Dimensions">
                  <label for="cabin_length" string="Length"/>
                  <div class="o_row">
                    <field name="cabin_length" class="oe_inline"/>
                    <field name="cabin_length_uom_id" class="oe_inline"/>
                  </div>
                  <label for="cabin_width" string="Width"/>
                  <div class="o_row">
                    <field name="cabin_width" class="oe_inline"/>
                    <field name="cabin_width_uom_id" class="oe_inline"/>
                  </div>
                  <label for="cabin_height" string="Height"/>
                  <div class="o_row">
                    <field name="cabin_height" class="oe_inline"/>
                    <field name="cabin_height_uom_id" class="oe_inline"/>
                  </div>
                </group>
                <group string="Seat Map" name="seat_map_group">
                  <field name="seat_map_1920" widget="image" />
                </group>
              </group>
            </page>

            <!-- Features & Amenities Tab -->
            <page string="Features &amp; Amenities" name="features">
              <group>
                <field
                  name="amenity_ids"
                  widget="many2many_tags"
                  placeholder="Select amenities"
                />
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="aircraft_new_action" model="ir.actions.act_window">
    <field name="name">New Aircraft</field>
    <field name="res_model">flight.aircraft</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="aircraft_view_form_add" />
    <field name="target">new</field>
  </record>
</odoo>
