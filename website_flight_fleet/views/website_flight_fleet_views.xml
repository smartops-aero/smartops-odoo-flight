<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ====== Aircraft Form Views ====== -->
    <record id="aircraft_view_form_add" model="ir.ui.view">
        <field name="name">flight.aircraft.view.form.add</field>
        <field name="model">flight.aircraft</field>
        <field name="arch" type="xml">
            <form js_class="website_new_content_form">
                <sheet>
                    <!-- Basic Information Section -->
                    <group name="basic_info">
                        <group>
                            <field name="website_url" invisible="1" />
                            <field
                name="registration"
                placeholder="Aircraft Registration"
                required="1"
              />
                            <field
                name="model_id"
                placeholder="Aircraft Model"
                required="1"
              />
                            <field
                name="website_display_name"
                placeholder="Name displayed on website (e.g. Citation Bravo N550RM)"
              />
                            <field
                name="website_aircraft_slogan"
                placeholder="Aircraft slogan or tagline"
              />
                            <field
                name="website_short_description"
                placeholder="Short description displayed on cards and detail page"
              />
                        </group>
                    </group>

                    <notebook>
                        <!-- Specifications Tab -->
                        <page string="Specifications" name="specifications">
                            <group>
                                <group string="Capacity">
                                    <field
                    name="passenger_capacity"
                    placeholder="Number of passengers"
                  />
                                    <field
                    name="luggage_capacity"
                    placeholder="Luggage capacity in cubic feet"
                  />
                                    <field
                    name="useful_load"
                    placeholder="Maximum useful load in pounds"
                  />
                                </group>
                                <group string="Performance">
                                    <field
                    name="range_nm"
                    placeholder="Range in nautical miles"
                  />
                                    <field
                    name="cruise_speed"
                    placeholder="Cruise speed in knots"
                  />
                                </group>
                                <group string="Cabin Dimensions">
                                    <label
                    for="cabin_length"
                    string="Dimensions (ft)"
                  />
                                    <div class="o_row">
                                        <field
                      name="cabin_length"
                      class="oe_inline"
                      placeholder="Length"
                    /> x <field
                      name="cabin_width"
                      class="oe_inline"
                      placeholder="Width"
                    /> x <field
                      name="cabin_height"
                      class="oe_inline"
                      placeholder="Height"
                    />
                                        <span> (L x W x H)</span>
                                    </div>
                                </group>
                                <group string="Seat Map" name="seat_map_group">
                                    <field
                    name="seat_map_1920"
                    widget="image"
                  />
                                </group>
                            </group>
                        </page>

                        <!-- Features & Amenities Tab -->
                        <page string="Features &amp; Amenities" name="features">
                            <group>
                                <field
                  name="amenity_ids"
                  widget="many2many_tags"
                  placeholder="Select amenities"
                />
                            </group>
                        </page>

                        <!-- Additional Information Tab -->
                        <page
              string="Additional Information"
              name="additional_info"
            >
                            <group>
                                <field name="is_available_for_lease" />
                                <field
                  name="lease_terms"
                  attrs="{'invisible': [('is_available_for_lease', '=', False)]}"
                />
                                <field name="regional_operations" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="aircraft_new_action" model="ir.actions.act_window">
        <field name="name">New Aircraft</field>
        <field name="res_model">flight.aircraft</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="aircraft_view_form_add" />
        <field name="target">new</field>
    </record>

    <!-- ====== Amenity Views ====== -->
    <!-- Amenity Tree View -->
    <record id="view_flight_aircraft_amenity_tree" model="ir.ui.view">
        <field name="name">flight.aircraft.amenity.tree</field>
        <field name="model">flight.aircraft.amenity</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <!-- Amenity Form View -->
    <record id="view_flight_aircraft_amenity_form" model="ir.ui.view">
        <field name="name">flight.aircraft.amenity.form</field>
        <field name="model">flight.aircraft.amenity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Amenity Search View -->
    <record id="view_flight_aircraft_amenity_search" model="ir.ui.view">
        <field name="name">flight.aircraft.amenity.search</field>
        <field name="model">flight.aircraft.amenity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <!-- Amenity Action Window -->
    <record id="action_flight_aircraft_amenity" model="ir.actions.act_window">
        <field name="name">Aircraft Amenities</field>
        <field name="res_model">flight.aircraft.amenity</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ====== Website Inherited Views ====== -->
    <record id="view_flight_aircraft_form_inherit_website" model="ir.ui.view">
        <field name="name">flight.aircraft.form.inherit.website</field>
        <field name="model">flight.aircraft</field>
        <field name="inherit_id" ref="flight.view_flight_aircraft_form" />
        <field name="arch" type="xml">
            <sheet position="inside">
                <notebook>
                    <page string="Website" name="website">
                        <group>
                            <group string="Publishing">
                                <field name="website_published" />
                                <field
                  name="website_display_name"
                  placeholder="Name displayed on website (e.g. Citation Bravo N550RM)"
                />
                                <field
                  name="website_aircraft_slogan"
                  placeholder="Aircraft slogan or tagline"
                />
                                <field name="website_short_description" />
                            </group>
                            <group string="Specifications">
                                <field name="passenger_capacity" />
                                <field name="range_nm" />
                                <field name="cruise_speed" />
                                <field name="useful_load" />
                                <field name="luggage_capacity" />
                                <label
                  for="cabin_length"
                  string="Cabin Dimensions (ft)"
                />
                                <div class="o_row" name="cabin_dimensions">
                                    <field
                    name="cabin_length"
                    class="oe_inline"
                  /> x <field name="cabin_width" class="oe_inline" /> x <field
                    name="cabin_height"
                    class="oe_inline"
                  />
                                    <span> (L x W x H)</span>
                                </div>
                            </group>
                        </group>

                        <group string="Seat Map">
                            <field name="seat_map_1920" widget="image" />
                        </group>

                        <group string="Amenities">
                            <field
                name="amenity_ids"
                widget="many2many_tags"
                placeholder="Select amenities"
              />
                        </group>

                        <group string="Additional Information">
                            <field name="is_available_for_lease" />
                            <field
                name="lease_terms"
                attrs="{'invisible': [('is_available_for_lease', '=', False)]}"
              />
                            <field name="regional_operations" />
                        </group>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

    <!-- Add menu item -->
    <menuitem
    id="menu_flight_aircraft_amenity"
    name="Amenities"
    parent="flight.menu_flight_aircraft_configuration"
    action="action_flight_aircraft_amenity"
    sequence="30"
  />

</odoo>
