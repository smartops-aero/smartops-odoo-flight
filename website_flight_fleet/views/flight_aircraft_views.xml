<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====== Website Inherited Views ====== -->
    <record id="view_flight_aircraft_form_inherit_website" model="ir.ui.view">
        <field name="name">flight.aircraft.form.inherit.website</field>
        <field name="model">flight.aircraft</field>
        <field name="inherit_id" ref="flight.view_flight_aircraft_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Website" name="website">
                    <group>
                        <group string="Publishing">
                            <field name="website_published" />
                            <field
                                name="website_display_name"
                                placeholder="Name displayed on website (e.g. Citation Bravo N550RM)"
                            />
                            <field
                                name="website_aircraft_slogan"
                                placeholder="Aircraft slogan or tagline"
                            />
                            <field
                                name="website_short_description"
                                placeholder="Short description displayed on cards and detail page"
                            />
                            <field
                                name="website_spec_header"
                                placeholder="Header displayed on specifications section"
                            />
                            <field
                                name="website_spec_description"
                                placeholder="Description displayed on specifications section"
                            />
                        </group>
                        <div class="o_settings_container mt-4">
                            <h2 class="o_horizontal_separator mt-4 mb-3">Carousel Images</h2>
                            <div class="alert alert-info mb-3" role="alert">
                                <i class="fa fa-info-circle me-2" /> Use the drag handle (☰) on the
                                left of each row to reorder images. Click Add a line to upload new
                                images. </div>

                            <field name="carousel_image_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field
                                        name="image"
                                        widget="image"
                                        options="{
                                        'size': [90, 90],
                                        'preview_image': 'image'
                                    }"
                                    />
                                    <field name="name" optional="show" placeholder="Optional title" />
                                    <field name="description" optional="show"
                                        placeholder="Optional caption" />
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <field
                                                name="image"
                                                widget="image"
                                                class="oe_avatar"
                                                options="{'size': [400, 400]}"
                                            />
                                            <field name="name"
                                                placeholder="Optional title for the image" />
                                            <field
                                                name="description"
                                                placeholder="Optional caption that will appear under the image in the carousel"
                                            />
                                            <field name="sequence" invisible="1" />
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>