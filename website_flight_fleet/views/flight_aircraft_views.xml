<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- ====== Website Inherited Views ====== -->
  <record id="view_flight_aircraft_form_inherit_website" model="ir.ui.view">
    <field name="name">flight.aircraft.form.inherit.website</field>
    <field name="model">flight.aircraft</field>
    <field name="inherit_id" ref="flight.view_flight_aircraft_form" />
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Website" name="website">
          <group>
            <group string="Publishing" colspan="2">
              <field name="website_published" />
              <field
                name="website_url"
                readonly="1"
                widget="url"
                text="View on Website"
              />
              <field
                name="website_display_name"
                placeholder="Name displayed on website (e.g. Citation Bravo N550RM)"
              />
              <field
                name="website_aircraft_slogan"
                placeholder="Aircraft slogan or tagline"
              />
              <field
                name="website_short_description"
                placeholder="Short description displayed on cards and detail page"
              />
              <field
                name="website_spec_header"
                placeholder="Header displayed on specifications section"
              />
              <field
                name="website_spec_description"
                placeholder="Description displayed on specifications section"
              />
              <field name="website_description" invisible="1" />
              <button
                string="Generate Static Content"
                type="object"
                name="regenerate_website_description"
                attrs="{'invisible': [('website_description', 'not in', ['', False])]}"
                class="oe_highlight"
              />
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>
  <record
    id="view_flight_aircraft_form_inherit_website_images"
    model="ir.ui.view"
  >
    <field name="name">flight.aircraft.form.inherit.website.images</field>
    <field name="model">flight.aircraft</field>
    <field name="inherit_id" ref="flight.view_flight_aircraft_form" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='images']" position="inside">
        <group string="Aircraft Images">
          <div colspan="2" class="alert alert-info mb-3" role="alert">
            <i
              class="fa fa-info-circle me-2"
            /> Use the drag handle (☰) on the left of each row
            to reorder images. Click Add a line to upload new images.
          </div>
          <field name="aircraft_image_ids" colspan="2" nolabel="1">
            <tree editable="bottom">
              <field name="sequence" widget="handle" />
              <field name="category_id" required="1" />
              <field
                name="image"
                widget="image"
                options="{
                  'size': [90, 90],
                  'preview_image': 'image'
                }"
              />
              <field name="name" optional="show" placeholder="Optional title" />
              <field
                name="description"
                optional="show"
                placeholder="Optional caption"
              />
            </tree>
          </field>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
