<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aircraft Detail Page -->
    <template id="page_aircraft_detail" name="Aircraft Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <!-- Hero Section -->
                <section
                    class="s_cover s_parallax_no_overflow_hidden py-7"
                    data-scroll-background-ratio="0"
                >
                    <div class="s_allow_columns">
                        <div class="s_text_block">
                            <div class="container text-center">
                                <div class="row justify-content-center">
                                    <div
                                        class="col-lg-7 o_animate o_anim_slide_in o_anim_from_bottom"
                                        style="--wanim-intensity: 10; animation-duration: 0.4s;"
                                    >
                                        <div class="mb-4">
                                            <h2
                                                class="fw-bold"
                                                t-field="aircraft.website_display_name"
                                            />
                                        </div>
                                        <div t-field="aircraft.hero_content" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Main Carousel -->
                <div t-field="aircraft.main_carousel_content" />

                <!-- Specifications Section -->
                <section class="py-7">
                    <div class="container">
                        <!-- Heading Section -->
                        <div class="mb-4">
                            <div t-field="aircraft.spec_header_content" />
                        </div>
                        <div class="row align-items-center g-5">
                            <div class="col-lg-6">
                                <div class="mb-4">
                                    <div
                                        class="lead text-black"
                                        t-field="aircraft.website_short_description"
                                    />
                                </div>

                                <div class="row gx-4 mt-2">
                                    <div class="col-md-6">
                                        <div class="mb-4">
                                            <h6
                                                class="fw-bold"
                                            >Specifications</h6>
                                        </div>
                                        <p class="mb-0">
                                            <strong>Seats:</strong> <t
                                                t-esc="aircraft.passenger_capacity"
                                            /> passengers<br />
                                            <strong>
                                            Range:</strong> <t
                                                t-esc="aircraft.range"
                                            /> nm<br />
                                            <strong>Cruise
                                            Speed:</strong> <t
                                                t-esc="aircraft.cruise_speed"
                                            /> knots<br />
                                            <strong>Useful
                                            Load:</strong> <t
                                                t-esc="aircraft.useful_load"
                                            /> lbs<br />
                                            <strong>Cabin
                                            Dimensions:</strong>
                                            <t t-esc="aircraft.cabin_length" />
                                            ft (length) x <t
                                                t-esc="aircraft.cabin_width"
                                            /> ft (width) x <t
                                                t-esc="aircraft.cabin_height"
                                            /> ft (height)<br />
                                            <strong>Luggage
                                            Capacity:</strong> <t
                                                t-esc="aircraft.luggage_capacity"
                                            /> cubic feet </p>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-4">
                                            <h6
                                                class="fw-bold"
                                            >Aircraft Highlights</h6>
                                        </div>
                                        <ul class="list-unstyled mb-0">
                                            <t
                                                t-foreach="aircraft.amenity_ids"
                                                t-as="amenity"
                                            >
                                                <li>- <t
                                                        t-esc="amenity.name"
                                                    /></li>
                                            </t>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div
                                    class="d-flex justify-content-center align-items-center h-100"
                                >
                                    <img
                                        t-if="aircraft.seat_map_1920"
                                        t-att-src="website.image_url(aircraft, 'seat_map_1920')"
                                        class="img-fluid"
                                        alt="Seat Map"
                                        style="max-height: 16rem !important"
                                    />
                                    <div
                                        t-elif="is_website_editor"
                                        class="alert alert-info text-center"
                                    >
                                        Add a seat map image in the aircraft configuration
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </section>
                <div t-field="aircraft.interior_gallery_header_content" />
                <!-- Interior Gallery -->

                <div t-field="aircraft.interior_gallery_carousel_content" />


                <div t-field="aircraft.benefits_content" />

                <!-- FAQs -->

                <div t-field="aircraft.faq_header_content" />
                <!-- FAQS -->
                <div t-field="aircraft.faq_content" />


                <!-- Contact CTA -->
                <div t-field="aircraft.cta_content" />
            </div>
        </t>
    </template>
</odoo>