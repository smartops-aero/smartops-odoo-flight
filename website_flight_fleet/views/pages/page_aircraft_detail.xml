<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_aircraft_detail" name="Aircraft Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <t t-if="aircraft.website_description_view_id">
                    <t t-call="{{aircraft.website_description_view_id.key}}">
                        <t t-set="aircraft" t-value="aircraft"/>
                    </t>
                </t>
            </div>
        </t>
    </template>
</odoo>