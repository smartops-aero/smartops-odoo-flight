<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_website_flight_fleet_dynamic_carousel" name="Aircraft Category Dynamic Carousel">
        <section class="s_website_flight_fleet_dynamic_carousel" data-aircraft-id="0" data-category-id="0">
            <div class="container text-center py-5">
                <div class="editor-message">
                    <i class="fa fa-cog fa-2x mb-3 text-muted"></i>
                    <p class="lead text-muted">Please select an aircraft and image category in the options panel to display images.</p>
                </div>
                <div class="dynamic-carousel-container d-none">
                    <t t-call="website_flight_fleet.s_website_flight_fleet_carousel"/>
                </div>
            </div>
        </section>
    </template>
</odoo>