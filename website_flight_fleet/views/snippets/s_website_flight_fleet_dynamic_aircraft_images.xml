<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_website_flight_fleet_dynamic_aircraft_images" name="Aircraft Images">
        <section class="s_website_flight_fleet_dynamic_aircraft_images" data-snippet="s_website_flight_fleet_dynamic_aircraft_images">
            <t t-call="website.s_dynamic_snippet_template">
                <t t-set="snippet_name" t-value="'s_website_flight_fleet_dynamic_aircraft_images'"/>
                <t t-set="snippet_classes" t-value="'s_website_flight_fleet_dynamic_aircraft_images'"/>
            </t>
        </section>
    </template>

    <template id="dynamic_filter_template_aircraft_image" name="Aircraft Image Carousel">
        <div class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                <t t-foreach="records" t-as="data" data-number-of-records="1" data-number-of-records-fetched="8">
                    <t t-set="record" t-value="data['_record']"/>
                    <div t-attf-class="carousel-item #{data_index == 0 and 'active'}">
                        <img t-att-src="website.image_url(record, 'image')" class="d-block w-100" t-att-alt="record.name"/>
                        <div class="carousel-caption d-none d-md-block">
                            <h5 t-field="record.name"/>
                            <p t-field="record.description"/>
                        </div>
                    </div>
                </t>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"/>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                <span class="carousel-control-next-icon"/>
            </button>
        </div>
    </template>

    <template id="s_website_flight_fleet_dynamic_aircraft_images_options" inherit_id="website.s_dynamic_snippet_options_template">
        <xpath expr="//div[@data-js='Dynamic']" position="inside">
            <we-select t-if="snippet_name == 's_website_flight_fleet_dynamic_aircraft_images'" string="Aircraft" data-name="aircraft_opt" data-attribute-name="aircraftId">
                <we-button data-select-data-attribute="0">All Aircraft</we-button>
                <!-- Populated via JS -->
            </we-select>
            <we-select t-if="snippet_name == 's_website_flight_fleet_dynamic_aircraft_images'" string="Category" data-name="category_opt" data-attribute-name="categoryId">
                <we-button data-select-data-attribute="0">All Categories</we-button>
                <!-- Populated via JS -->
            </we-select>
        </xpath>
    </template>
</odoo>