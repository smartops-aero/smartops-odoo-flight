<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Snippet Template -->
    <template id="s_website_flight_fleet_dynamic_aircraft_images" name="Aircraft Images">
        <section class="s_website_flight_fleet_dynamic_aircraft_images"
            data-snippet="s_dynamic_snippet">
            <div class="container">
                <div class="dynamic_snippet_template" />
            </div>
        </section>
    </template>

    <!-- Dynamic Filter Template -->
    <template id="dynamic_filter_template_flight_aircraft_image_carousel" name="Aircraft Image Carousel">
        <div t-foreach="records" t-as="data" class="carousel slide" data-bs-ride="carousel"
            data-number-of-elements="1"
            data-number-of-elements-sm="1"
            data-number-of-elements-fetch="16">
            <t t-set="record" t-value="data['_record']" />
            <div class="carousel-inner">
                <div t-attf-class="carousel-item #{data_index == 0 and 'active'}">
                    <img t-att-src="website.image_url(record, 'image')" class="d-block w-100"
                        t-att-alt="record.name" />
                    <div class="carousel-caption d-none d-md-block">
                        <h5 t-field="record.name" />
                        <p t-field="record.description" />
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button"
                t-attf-data-bs-target="#carousel{{data_index}}"
                data-bs-slide="prev">
                <span class="carousel-control-prev-icon" />
            </button>
            <button class="carousel-control-next" type="button"
                t-attf-data-bs-target="#carousel{{data_index}}"
                data-bs-slide="next">
                <span class="carousel-control-next-icon" />
            </button>
        </div>
    </template>

    <!-- Snippet Options -->
    <template id="s_website_flight_fleet_dynamic_aircraft_images_options"
        inherit_id="website.snippet_options">
        <xpath expr="." position="inside">
            <div data-js="s_website_flight_fleet_dynamic_aircraft_images"
                data-selector=".s_website_flight_fleet_dynamic_aircraft_images">
                <t t-call="website.s_dynamic_snippet_options_template">
                    <t t-set="snippet_name"
                        t-value="'dynamic_website_flight_fleet_dynamic_aircraft_images'" />
                    <t t-set="snippet_selector"
                        t-value="'.s_website_flight_fleet_dynamic_aircraft_images'" />
                </t>
            </div>
        </xpath>
    </template>
</odoo>