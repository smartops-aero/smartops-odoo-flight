<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="s_website_flight_fleet_carousel" name="Aircraft Carousel">
        <section class="s_carousel_wrapper" data-snippet="s_website_flight_fleet_carousel" data-name="Flight Fleet Carousel">
            <t t-set="uniq" t-value="datetime.datetime.now().microsecond" />
            <div
        class="s_website_flight_fleet_carousel s_carousel s_carousel_default carousel slide"
        t-attf-id="aircraftCarousel{{uniq}}"
        data-bs-interval="10000"
      >
                <!-- Indicators -->
                <ol
          class="carousel-indicators website-flight-carousel-indicators"
        >
                    <li
            t-attf-data-bs-target="#aircraftCarousel{{uniq}}"
            data-bs-slide-to="0"
            class="active"
          />
                    <li
            t-attf-data-bs-target="#aircraftCarousel{{uniq}}"
            data-bs-slide-to="1"
          />
                    <li
            t-attf-data-bs-target="#aircraftCarousel{{uniq}}"
            data-bs-slide-to="2"
          />
                </ol>

                <div class="carousel-inner">
                    <!-- Default items that can be edited -->
                    <div
            class="carousel-item oe_img_bg o_bg_img_center active"
            data-name="Slide"
            style="background-image: url('/web/image/website.s_carousel_default_image_1');"
          >

                    </div>
                    <div
            class="carousel-item oe_img_bg o_bg_img_center"
            data-name="Slide"
            style="background-image: url('/web/image/website.s_carousel_default_image_2');"
          >

                    </div>
                    <div
            class="carousel-item oe_img_bg o_bg_img_center"
            data-name="Slide"
            style="background-image: url('/web/image/website.s_carousel_default_image_3');"
          >

                    </div>
                </div>

                <!-- Controls -->
                <button
          class="carousel-control-prev"
          type="button"
          t-attf-data-bs-target="#aircraftCarousel{{uniq}}"
          data-bs-slide="prev"
        >
                    <span
            class="carousel-control-prev-icon"
            aria-hidden="true"
          />
                    <span class="visually-hidden">Previous</span>
                </button>
                <button
          class="carousel-control-next"
          type="button"
          t-attf-data-bs-target="#aircraftCarousel{{uniq}}"
          data-bs-slide="next"
        >
                    <span
            class="carousel-control-next-icon"
            aria-hidden="true"
          />
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </section>
    </template>
</odoo>
