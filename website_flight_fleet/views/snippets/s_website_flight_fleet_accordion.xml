<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
    id="s_website_flight_fleet_accordion"
    name="Website Flight Accordion"
  >
        <section class="s_website_flight_fleet_accordion">
            <div class="container">
                <t t-set="uniq" t-value="datetime.datetime.now().microsecond" />
                <div id="myCollapse" class="accordion ps-4" role="tablist">
                    <!-- Default accordion item - can be duplicated -->
                    <div class="accordion-item border-0">
                        <h2 class="accordion-header">
                            <button
                t-attf-data-bs-target="#myCollapseTab{{uniq}}_1"
                role="tab"
                data-bs-toggle="collapse"
                aria-expanded="true"
                class="accordion-button lead text-black fw-bold bg-transparent"
              >
                                Question Title <span
                  class="transition-icon ms-auto"
                >
                                    <div class="embed-icon">
                                        <svg
                      width="100%"
                      height="100%"
                      viewBox="0 0 32 32"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                                            <path
                        d="M25.3333 15.667V16.3336C25.3333 16.7018 25.0349 17.0003 24.6667 17.0003H17V24.667C17 25.0351 16.7015 25.3336 16.3333 25.3336H15.6667C15.2985 25.3336 15 25.0351 15 24.667V17.0003H7.3333C6.96511 17.0003 6.66663 16.7018 6.66663 16.3336V15.667C6.66663 15.2988 6.96511 15.0003 7.3333 15.0003H15V7.33365C15 6.96546 15.2985 6.66699 15.6667 6.66699H16.3333C16.7015 6.66699 17 6.96546 17 7.33365V15.0003H24.6667C25.0349 15.0003 25.3333 15.2988 25.3333 15.667Z"
                        fill="currentColor"
                      />
                                        </svg>
                                    </div>
                                </span>
                            </button>
                        </h2>
                        <div
              t-attf-id="myCollapseTab{{uniq}}_1"
              class="accordion-collapse collapse show"
              data-bs-parent="#myCollapse"
              role="tabpanel"
            >
                            <div class="accordion-body pt-0 max-width-large">
                                <p class="text-black">Answer text goes here</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
