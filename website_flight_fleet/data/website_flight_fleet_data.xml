<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <!-- Website menu item configurations -->
        <record id="menu_fleet" model="website.menu">
            <field name="name">Fleet</field>
            <field name="url">/fleet</field>
            <field name="parent_id" ref="website.main_menu" />
            <field name="sequence">50</field>
        </record>
        <!-- Exterior Views Category -->
        <record
    id="aircraft_image_category_exterior"
    model="flight.aircraft.image.category"
  >
            <field name="name">Exterior Views</field>
            <field name="code">exterior</field>
            <field name="sequence">10</field>
            <field
      name="description"
    >External views of the aircraft including profile, front, and
                rear angles</field>
        </record>

        <!-- Interior Views Category -->
        <record
    id="aircraft_image_category_interior"
    model="flight.aircraft.image.category"
  >
            <field name="name">Interior Views</field>
            <field name="code">interior</field>
            <field name="sequence">20</field>
            <field
      name="description"
    >Interior cabin views including seating configurations and
                amenities</field>
        </record>

        <!-- Cockpit Category -->
        <record
    id="aircraft_image_category_cockpit"
    model="flight.aircraft.image.category"
  >
            <field name="name">Cockpit</field>
            <field name="code">cockpit</field>
            <field name="sequence">30</field>
            <field name="description">Cockpit and flight deck images</field>
        </record>

        <!-- Aerial Shots Category -->
        <record
    id="aircraft_image_category_aerial"
    model="flight.aircraft.image.category"
  >
            <field name="name">Aerial Shots</field>
            <field name="code">aerial</field>
            <field name="sequence">40</field>
            <field
      name="description"
    >Aircraft in flight and aerial photography</field>
        </record>

        <!-- Filter for Aircraft Images -->
        <record id="dynamic_snippet_aircraft_images_filter" model="ir.filters">
            <field name="name">Aircraft Images</field>
            <field name="model_id">flight.aircraft.image</field>
            <field name="user_id" eval="False" />
            <field name="domain">[]</field>
            <field name="sort">["sequence asc"]</field>
            <field name="action_id" ref="website.action_website" />
        </record>

        <!-- Dynamic Filter -->
        <record
    id="dynamic_filter_aircraft_images"
    model="website.snippet.filter"
  >
            <field name="name">flight_aircraft_image</field>
            <field
      name="filter_id"
      ref="website_flight_fleet.dynamic_snippet_aircraft_images_filter"
    />
            <field name="field_names">name,description,sequence</field>
            <field name="limit" eval="16" />
        </record>
</odoo>
