<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Connectivity -->
        <record id="amenity_wifi" model="flight.aircraft.amenity">
            <field name="name">Starlink WiFi</field>
            <field name="sequence">10</field>
        </record>
        <record id="amenity_power" model="flight.aircraft.amenity">
            <field name="name">Power Outlets</field>
            <field name="sequence">20</field>
        </record>

        <!-- Comfort -->
        <record id="amenity_quiet_cabin" model="flight.aircraft.amenity">
            <field name="name">Quiet Cabin</field>
            <field name="sequence">30</field>
        </record>
        <record id="amenity_lavatory" model="flight.aircraft.amenity">
            <field name="name">Enclosed Aft Lavatory</field>
            <field name="sequence">40</field>
        </record>
        <record id="amenity_air_conditioning" model="flight.aircraft.amenity">
            <field name="name">Air Conditioning</field>
            <field name="sequence">50</field>
        </record>
        <record id="amenity_leather_seats" model="flight.aircraft.amenity">
            <field name="name">Leather Seats</field>
            <field name="sequence">60</field>
        </record>

        <!-- Entertainment -->
        <record id="amenity_entertainment" model="flight.aircraft.amenity">
            <field name="name">Entertainment System</field>
            <field name="sequence">70</field>
        </record>

        <!-- Refreshments -->
        <record id="amenity_refreshments" model="flight.aircraft.amenity">
            <field name="name">Refreshment Center</field>
            <field name="sequence">80</field>
        </record>

        <!-- Storage -->
        <record id="amenity_cargo_door" model="flight.aircraft.amenity">
            <field name="name">Cargo Door</field>
            <field name="sequence">90</field>
        </record>
        <!-- Website menu item configurations -->
        <record id="menu_fleet" model="website.menu">
            <field name="name">Fleet</field>
            <field name="url">/fleet</field>
            <field name="parent_id" ref="website.main_menu" />
            <field name="sequence">50</field>
        </record>

        <!-- Fleet page -->
        <record id="fleet_page" model="website.page">
            <field name="url">/fleet</field>
            <field name="website_published">True</field>
            <field name="website_indexed" eval="True" />
            <field name="name">Fleet</field>
            <field name="type">qweb</field>
            <field name="key">website_flight_fleet.fleet_page</field>
            <field name="arch" type="xml">
                <t
          name="Fleet"
          priority="29"
          t-name="website_flight_fleet.fleet_page"
        >
                    <t t-call="website.layout">
                        <div id="wrap" class="oe_structure oe_empty">
                            <section
                class="s_title pt32 pb32"
                data-vcss="001"
                data-snippet="s_title"
              >
                                <div class="container s_allow_columns">
                                    <h1
                    style="text-align: center;"
                  >Our Fleet</h1>
                                </div>
                            </section>
                        </div>
                    </t>
                </t>
            </field>
        </record>

        <!-- Amenities -->
        <record id="amenity_wifi" model="flight.aircraft.amenity">
            <field name="name">Starlink WiFi</field>
            <field name="sequence">10</field>
        </record>

        <record id="amenity_power" model="flight.aircraft.amenity">
            <field name="name">Power Outlets</field>
            <field name="sequence">20</field>
        </record>

        <record id="amenity_lavatory" model="flight.aircraft.amenity">
            <field name="name">Enclosed Aft Lavatory</field>
            <field name="sequence">30</field>
        </record>

        <record id="amenity_quiet_cabin" model="flight.aircraft.amenity">
            <field name="name">Quiet Cabin</field>
            <field name="sequence">40</field>
        </record>
    </data>
</odoo>
