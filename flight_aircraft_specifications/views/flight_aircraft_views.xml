<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flight_aircraft_form_inherit_specifications" model="ir.ui.view">
        <field name="name">flight.aircraft.form.inherit.specifications</field>
        <field name="model">flight.aircraft</field>
        <field name="inherit_id" ref="flight.view_flight_aircraft_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Specifications" name="specifications">
                    <group>
                        <group string="Capacity">
                            <field name="passenger_capacity" placeholder="Number of passengers"/>
                            <label for="luggage_capacity" string="Luggage Capacity"/>
                            <div class="o_row">
                                <field name="luggage_capacity" class="oe_inline"/>
                                <field name="luggage_capacity_uom_id" class="oe_inline"/>
                            </div>
                            <label for="useful_load" string="Useful Load"/>
                            <div class="o_row">
                                <field name="useful_load" class="oe_inline"/>
                                <field name="useful_load_uom_id" class="oe_inline"/>
                            </div>
                        </group>
                        <group string="Performance">
                            <label for="range_nm" string="Range"/>
                            <div class="o_row">
                                <field name="range_nm" class="oe_inline"/>
                                <field name="range_uom_id" class="oe_inline"/>
                            </div>
                            <label for="cruise_speed" string="Cruise Speed"/>
                            <div class="o_row">
                                <field name="cruise_speed" class="oe_inline"/>
                                <field name="cruise_speed_uom_id" class="oe_inline"/>
                            </div>
                        </group>
                        <group string="Cabin Dimensions">
                            <label for="cabin_length" string="Length"/>
                            <div class="o_row">
                                <field name="cabin_length" class="oe_inline"/>
                                <field name="cabin_length_uom_id" class="oe_inline"/>
                            </div>
                            <label for="cabin_width" string="Width"/>
                            <div class="o_row">
                                <field name="cabin_width" class="oe_inline"/>
                                <field name="cabin_width_uom_id" class="oe_inline"/>
                            </div>
                            <label for="cabin_height" string="Height"/>
                            <div class="o_row">
                                <field name="cabin_height" class="oe_inline"/>
                                <field name="cabin_height_uom_id" class="oe_inline"/>
                            </div>
                        </group>
                        <group string="Seat Map">
                            <field name="seat_map_1920" widget="image"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>