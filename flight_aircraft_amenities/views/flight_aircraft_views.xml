<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flight_aircraft_amenity_tree" model="ir.ui.view">
        <field name="name">flight.aircraft.amenity.tree</field>
        <field name="model">flight.aircraft.amenity</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_flight_aircraft_amenity_form" model="ir.ui.view">
        <field name="name">flight.aircraft.amenity.form</field>
        <field name="model">flight.aircraft.amenity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_flight_aircraft_form_inherit_amenities" model="ir.ui.view">
        <field name="name">flight.aircraft.form.inherit.amenities</field>
        <field name="model">flight.aircraft</field>
        <field name="inherit_id" ref="flight.view_flight_aircraft_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Amenities" name="amenities">
                    <group>
                        <field name="amenity_ids" widget="many2many_tags" placeholder="Select amenities"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="action_flight_aircraft_amenity" model="ir.actions.act_window">
        <field name="name">Aircraft Amenities</field>
        <field name="res_model">flight.aircraft.amenity</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>