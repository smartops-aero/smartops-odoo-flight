<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Flight Import Wizard Form View -->
    <record id="view_flight_import_wizard_form" model="ir.ui.view">
        <field name="name">flight.import.wizard.form</field>
        <field name="model">flight.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Flight Data">
                <sheet>
                    <field name="state" invisible="1"/>
                    
                    <!-- Upload State -->
                    <div attrs="{'invisible': [('state', '!=', 'upload')]}">
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="template_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="file" filename="file_name"/>
                                <field name="file_name" invisible="1"/>
                                <field name="delimiter"/>
                                <field name="quotechar"/>
                            </group>
                        </group>
                    </div>
                    
                    <!-- Mapping State -->
                    <div attrs="{'invisible': [('state', '!=', 'mapping')]}">
                        <h3>File Preview</h3>
                        <field name="preview_ids">
                            <tree>
                                <field name="row_index"/>
                                <field name="row_data"/>
                                <field name="is_valid"/>
                                <field name="validation_message"/>
                            </tree>
                        </field>
                        <div class="alert alert-info" role="alert">
                            <p>The file has been parsed successfully. Please review the mappings in the template and proceed to preview.</p>
                        </div>
                    </div>
                    
                    <!-- Preview State -->
                    <div attrs="{'invisible': [('state', '!=', 'preview')]}">
                        <h3>Import Preview</h3>
                        <div class="alert alert-info" role="alert">
                            <p>The data has been validated and is ready to be imported. Click "Import" to proceed.</p>
                        </div>
                    </div>
                    
                    <!-- Done State -->
                    <div attrs="{'invisible': [('state', '!=', 'done')]}">
                        <h3>Import Results</h3>
                        <group>
                            <group>
                                <field name="imported_flight_count"/>
                                <field name="imported_time_count"/>
                                <field name="imported_event_count"/>
                            </group>
                        </group>
                        <field name="log_messages" widget="html"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_parse_file" string="Parse File" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'upload')]}"/>
                    <button name="action_preview_import" string="Preview Import" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'mapping')]}"/>
                    <button name="action_import" string="Import" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'preview')]}"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_flight_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Flight Data</field>
        <field name="res_model">flight.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
