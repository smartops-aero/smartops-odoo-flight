<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Default Import Configuration for CrewLounge PilotLog -->
    <record id="default_crewlounge_import_config" model="flight.import.config">
        <field name="name">CrewLounge PilotLog Import</field>
        <field name="description">Default configuration for importing CrewLounge PilotLog CSV files.</field>
        <field name="csv_has_header">True</field>
        <field name="csv_delimiter">,</field>
        <field name="csv_quotechar">"</field>
        <field name="date_format">%d-%m-%Y</field>
        <field name="remark_field">REMARKS</field>
    </record>

    <!-- Transformation Methods -->
    <record id="transform_method_parse_date" model="flight.import.transform.method">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="name">parse_date</field>
        <field name="method">flight.import.utils.parse_date</field>
        <field name="description">Parse date from DD-MM-YYYY format to YYYY-MM-DD</field>
    </record>
    
    <record id="transform_method_map_aircraft_category" model="flight.import.transform.method">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="name">map_aircraft_category</field>
        <field name="method">flight.import.utils.map_aircraft_category</field>
        <field name="description">Map aircraft class name to category</field>
    </record>
    
    <record id="transform_method_convert_to_float" model="flight.import.transform.method">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="name">convert_to_float</field>
        <field name="method">flight.import.utils.convert_to_float</field>
        <field name="description">Convert string to float</field>
    </record>

    <!-- Model Mappings -->
    
    <!-- 1. Aerodrome Mapping -->
    <record id="model_mapping_aerodrome" model="flight.import.model.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">10</field>
        <field name="source_model">aerodrome</field>
        <field name="target_model">flight.aerodrome</field>
        <field name="lookup_fields">icao</field>
        <field name="skip_if_required_missing">True</field>
    </record>
    
    <!-- Aerodrome Field Mappings -->
    <record id="field_mapping_aerodrome_dep" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_aerodrome"/>
        <field name="sequence">10</field>
        <field name="source_field">AF_DEP</field>
        <field name="target_field">icao</field>
        <field name="required">True</field>
    </record>
    
    <record id="field_mapping_aerodrome_name" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_aerodrome"/>
        <field name="sequence">20</field>
        <field name="source_field">AF_DEP</field>
        <field name="target_field">name</field>
    </record>
    
    <!-- 2. Aircraft Make Mapping -->
    <record id="model_mapping_aircraft_make" model="flight.import.model.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">20</field>
        <field name="source_model">aircraft_make</field>
        <field name="target_model">flight.aircraft.make</field>
        <field name="lookup_fields">name</field>
        <field name="skip_if_required_missing">True</field>
    </record>
    
    <!-- Aircraft Make Field Mappings -->
    <record id="field_mapping_aircraft_make_name" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_aircraft_make"/>
        <field name="sequence">10</field>
        <field name="source_field">AC_MAKE</field>
        <field name="target_field">name</field>
        <field name="required">True</field>
    </record>
    
    <!-- 3. Aircraft Class Mapping -->
    <record id="model_mapping_aircraft_class" model="flight.import.model.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">30</field>
        <field name="source_model">aircraft_class</field>
        <field name="target_model">flight.aircraft.class</field>
        <field name="lookup_fields">name,aircraft_category</field>
        <field name="skip_if_required_missing">True</field>
    </record>
    
    <!-- Aircraft Class Field Mappings -->
    <record id="field_mapping_aircraft_class_name" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_aircraft_class"/>
        <field name="sequence">10</field>
        <field name="source_field">AC_CLASS</field>
        <field name="target_field">name</field>
        <field name="required">True</field>
    </record>
    
    <record id="field_mapping_aircraft_class_category" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_aircraft_class"/>
        <field name="sequence">20</field>
        <field name="source_field">AC_CLASS</field>
        <field name="target_field">aircraft_category</field>
        <field name="transform">map_aircraft_category</field>
    </record>
    
    <!-- 4. Aircraft Model Mapping -->
    <record id="model_mapping_aircraft_model" model="flight.import.model.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">40</field>
        <field name="source_model">aircraft_model</field>
        <field name="target_model">flight.aircraft.model</field>
        <field name="lookup_fields">name,make_id</field>
        <field name="skip_if_required_missing">True</field>
    </record>
    
    <!-- Aircraft Model Field Mappings -->
    <record id="field_mapping_aircraft_model_name" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_aircraft_model"/>
        <field name="sequence">10</field>
        <field name="source_field">AC_MODEL</field>
        <field name="target_field">name</field>
        <field name="required">True</field>
    </record>
    
    <record id="field_mapping_aircraft_model_make" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_aircraft_model"/>
        <field name="sequence">20</field>
        <field name="source_field">AC_MAKE</field>
        <field name="target_field">make_id</field>
        <field name="relation">flight.aircraft.make</field>
        <field name="relation_field">name</field>
    </record>
    
    <record id="field_mapping_aircraft_model_class" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_aircraft_model"/>
        <field name="sequence">30</field>
        <field name="source_field">AC_CLASS</field>
        <field name="target_field">class_id</field>
        <field name="relation">flight.aircraft.class</field>
        <field name="relation_field">name</field>
    </record>
    
    <record id="field_mapping_aircraft_model_code" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_aircraft_model"/>
        <field name="sequence">40</field>
        <field name="source_field">AC_MODEL</field>
        <field name="target_field">code</field>
    </record>
    
    <!-- 5. Aircraft Mapping -->
    <record id="model_mapping_aircraft" model="flight.import.model.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">50</field>
        <field name="source_model">aircraft</field>
        <field name="target_model">flight.aircraft</field>
        <field name="lookup_fields">registration</field>
        <field name="skip_if_required_missing">True</field>
    </record>
    
    <!-- Aircraft Field Mappings -->
    <record id="field_mapping_aircraft_registration" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_aircraft"/>
        <field name="sequence">10</field>
        <field name="source_field">AC_REG</field>
        <field name="target_field">registration</field>
        <field name="required">True</field>
    </record>
    
    <record id="field_mapping_aircraft_model" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_aircraft"/>
        <field name="sequence">20</field>
        <field name="source_field">AC_MODEL</field>
        <field name="target_field">model_id</field>
        <field name="relation">flight.aircraft.model</field>
        <field name="relation_field">name</field>
    </record>
    
    <!-- 6. Flight Mapping -->
    <record id="model_mapping_flight" model="flight.import.model.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">60</field>
        <field name="source_model">flight</field>
        <field name="target_model">flight.flight</field>
        <field name="lookup_fields">date,aircraft_id,departure_id,arrival_id</field>
        <field name="skip_if_required_missing">True</field>
    </record>
    
    <!-- Flight Field Mappings -->
    <record id="field_mapping_flight_date" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_flight"/>
        <field name="sequence">10</field>
        <field name="source_field">PILOTLOG_DATE</field>
        <field name="target_field">date</field>
        <field name="transform">parse_date</field>
        <field name="required">True</field>
    </record>
    
    <record id="field_mapping_flight_aircraft" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_flight"/>
        <field name="sequence">20</field>
        <field name="source_field">AC_REG</field>
        <field name="target_field">aircraft_id</field>
        <field name="relation">flight.aircraft</field>
        <field name="relation_field">registration</field>
        <field name="required">True</field>
    </record>
    
    <record id="field_mapping_flight_departure" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_flight"/>
        <field name="sequence">30</field>
        <field name="source_field">AF_DEP</field>
        <field name="target_field">departure_id</field>
        <field name="relation">flight.aerodrome</field>
        <field name="relation_field">icao</field>
        <field name="required">True</field>
    </record>
    
    <record id="field_mapping_flight_arrival" model="flight.import.field.mapping">
        <field name="model_mapping_id" ref="model_mapping_flight"/>
        <field name="sequence">40</field>
        <field name="source_field">AF_ARR</field>
        <field name="target_field">arrival_id</field>
        <field name="relation">flight.aerodrome</field>
        <field name="relation_field">icao</field>
        <field name="required">True</field>
    </record>
    
    <!-- Pilot Time Mappings -->
    <record id="time_mapping_pic" model="flight.import.time.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">10</field>
        <field name="source_field">TIME_PIC</field>
        <field name="time_code_id" ref="flight_pilotlog.flight_pilot_time_code_pic"/>
        <field name="convert_to_hours">True</field>
        <field name="divisor">60.0</field>
    </record>
    
    <record id="time_mapping_sic" model="flight.import.time.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">20</field>
        <field name="source_field">TIME_SIC</field>
        <field name="time_code_id" ref="flight_pilotlog.flight_pilot_time_code_sic"/>
        <field name="convert_to_hours">True</field>
        <field name="divisor">60.0</field>
    </record>
    
    <record id="time_mapping_dual" model="flight.import.time.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">30</field>
        <field name="source_field">TIME_DUAL</field>
        <field name="time_code_id" ref="flight_pilotlog.flight_pilot_time_code_dual"/>
        <field name="convert_to_hours">True</field>
        <field name="divisor">60.0</field>
    </record>
    
    <record id="time_mapping_instructor" model="flight.import.time.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">40</field>
        <field name="source_field">TIME_INSTRUCTOR</field>
        <field name="time_code_id" ref="flight_pilotlog.flight_pilot_time_code_instructor"/>
        <field name="convert_to_hours">True</field>
        <field name="divisor">60.0</field>
    </record>
    
    <record id="time_mapping_night" model="flight.import.time.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">50</field>
        <field name="source_field">TIME_NIGHT</field>
        <field name="time_code_id" ref="flight_pilotlog.flight_pilot_time_code_night"/>
        <field name="convert_to_hours">True</field>
        <field name="divisor">60.0</field>
    </record>
    
    <record id="time_mapping_ifr" model="flight.import.time.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">60</field>
        <field name="source_field">TIME_IFR</field>
        <field name="time_code_id" ref="flight_pilotlog.flight_pilot_time_code_ifr"/>
        <field name="convert_to_hours">True</field>
        <field name="divisor">60.0</field>
    </record>
    
    <record id="time_mapping_xc" model="flight.import.time.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">70</field>
        <field name="source_field">TIME_XC</field>
        <field name="time_code_id" ref="flight_pilotlog.flight_pilot_time_code_xc"/>
        <field name="convert_to_hours">True</field>
        <field name="divisor">60.0</field>
    </record>
    
    <record id="time_mapping_total" model="flight.import.time.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">80</field>
        <field name="source_field">TIME_TOTAL</field>
        <field name="time_code_id" ref="flight_pilotlog.flight_pilot_time_code_total"/>
        <field name="convert_to_hours">True</field>
        <field name="divisor">60.0</field>
    </record>
    
    <!-- Pilot Event Mappings -->
    <record id="event_mapping_to_day" model="flight.import.event.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">10</field>
        <field name="source_field">TO_DAY</field>
        <field name="event_code_id" ref="flight_pilotlog.flight_pilot_event_code_to_day"/>
    </record>
    
    <record id="event_mapping_to_night" model="flight.import.event.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">20</field>
        <field name="source_field">TO_NIGHT</field>
        <field name="event_code_id" ref="flight_pilotlog.flight_pilot_event_code_to_night"/>
    </record>
    
    <record id="event_mapping_ldg_day" model="flight.import.event.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">30</field>
        <field name="source_field">LDG_DAY</field>
        <field name="event_code_id" ref="flight_pilotlog.flight_pilot_event_code_ldg_day"/>
    </record>
    
    <record id="event_mapping_ldg_night" model="flight.import.event.mapping">
        <field name="config_id" ref="default_crewlounge_import_config"/>
        <field name="sequence">40</field>
        <field name="source_field">LDG_NIGHT</field>
        <field name="event_code_id" ref="flight_pilotlog.flight_pilot_event_code_ldg_night"/>
    </record>
</odoo>