<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Import Configuration Views -->
    <record id="view_flight_import_config_tree" model="ir.ui.view">
        <field name="name">flight.import.config.tree</field>
        <field name="model">flight.import.config</field>
        <field name="arch" type="xml">
            <tree string="Import Configurations">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_flight_import_config_form" model="ir.ui.view">
        <field name="name">flight.import.config.form</field>
        <field name="model">flight.import.config</field>
        <field name="arch" type="xml">
            <form string="Import Configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Configuration Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="description" placeholder="Description of this import configuration..."/>
                        <field name="default_pilot_id"/>
                    </group>
                    <notebook>
                        <page string="CSV Settings">
                            <group>
                                <field name="csv_has_header"/>
                                <field name="csv_delimiter"/>
                                <field name="csv_quotechar"/>
                                <field name="date_format"/>
                                <field name="remark_field" placeholder="REMARKS"/>
                            </group>
                        </page>
                        <page string="Model Mappings">
                            <field name="model_mappings" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_model"/>
                                    <field name="target_model"/>
                                    <field name="lookup_fields"/>
                                    <field name="skip_if_required_missing"/>
                                    <button name="action_view_field_mappings" type="object" 
                                            string="Field Mappings" class="btn-sm btn-link"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Pilot Time Mappings">
                            <field name="time_mappings" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_field"/>
                                    <field name="time_code_id"/>
                                    <field name="convert_to_hours"/>
                                    <field name="divisor" attrs="{'invisible': [('convert_to_hours', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Pilot Event Mappings">
                            <field name="event_mappings" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_field"/>
                                    <field name="event_code_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Transform Methods">
                            <field name="transform_methods" nolabel="1">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="method"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Field Mapping Views -->
    <record id="view_flight_import_field_mapping_tree" model="ir.ui.view">
        <field name="name">flight.import.field.mapping.tree</field>
        <field name="model">flight.import.field.mapping</field>
        <field name="arch" type="xml">
            <tree string="Field Mappings" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="source_field"/>
                <field name="target_field"/>
                <field name="required"/>
                <field name="transform"/>
                <field name="relation"/>
                <field name="relation_field" attrs="{'invisible': [('relation', '=', False)]}"/>
                <field name="default_value"/>
            </tree>
        </field>
    </record>

    <!-- Actions for Configurations -->
    <record id="action_flight_import_config" model="ir.actions.act_window">
        <field name="name">Import Configurations</field>
        <field name="res_model">flight.import.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action to view field mappings -->
    <record id="action_flight_import_field_mapping" model="ir.actions.act_window">
        <field name="name">Field Mappings</field>
        <field name="res_model">flight.import.field.mapping</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('model_mapping_id', '=', active_id)]</field>
        <field name="context">{'default_model_mapping_id': active_id}</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_flight_import_config"
              name="Import Configurations"
              parent="flight.menu_flight_configuration"
              action="action_flight_import_config"
              sequence="90"/>
</odoo>