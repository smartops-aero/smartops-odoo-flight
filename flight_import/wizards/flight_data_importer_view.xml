<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="flight_data_importer_form" model="ir.ui.view">
        <field name="name">flight.data.importer.form</field>
        <field name="model">flight.data.importer</field>
        <field name="arch" type="xml">
            <form string="Import Flight Data">
                <group>
                    <field name="csv_file" filename="csv_file_name"/>
                    <field name="self_partner_id" domain="[('is_company', '=', False)]"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to Open the Wizard -->
    <record id="flight_data_importer_action" model="ir.actions.act_window">
        <field name="name">Import Flight Data</field>
        <field name="res_model">flight.data.importer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item to Access the Wizard -->
    <menuitem
        id="menu_import_flight_data"
        name="Import Flight Data"
        parent="flight.menu_flight_root"  
        action="flight_data_importer_action" />
</odoo>