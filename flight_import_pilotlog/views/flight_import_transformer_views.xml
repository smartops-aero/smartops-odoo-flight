<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_flight_import_transformer_tree" model="ir.ui.view">
        <field name="name">flight.import.pilotlog.transformer.tree</field>
        <field name="model">flight.import.pilotlog.transformer</field>
        <field name="arch" type="xml">
            <tree string="Flight Import Transformers">
                <field name="name"/>
                <field name="implementation"/>
                <field name="model_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_flight_import_transformer_form" model="ir.ui.view">
        <field name="name">flight.import.pilotlog.transformer.form</field>
        <field name="model">flight.import.pilotlog.transformer</field>
        <field name="arch" type="xml">
            <form string="Flight Import Transformer">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. CrewLounge Transformer"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="implementation"/>
                            <field name="model_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_flight_import_transformer_search" model="ir.ui.view">
        <field name="name">flight.import.pilotlog.transformer.search</field>
        <field name="model">flight.import.pilotlog.transformer</field>
        <field name="arch" type="xml">
            <search string="Flight Import Transformers">
                <field name="name"/>
                <field name="implementation"/>
                <field name="model_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Implementation" name="implementation" context="{'group_by': 'implementation'}"/>
                    <filter string="Target Model" name="model_id" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_flight_import_transformer" model="ir.actions.act_window">
        <field name="name">Flight Import Transformers</field>
        <field name="res_model">flight.import.pilotlog.transformer</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_flight_import_transformer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first flight import transformer
            </p>
            <p>
                Flight import transformers allow you to convert data from various formats
                into the format required by the flight module.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_flight_import_transformer"
        name="Flight Import Transformers"
        parent="base.menu_custom"
        action="action_flight_import_transformer"
        sequence="100"/>
</odoo>
