<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Flight Crew Views -->
    <record id="view_flight_crew_tree" model="ir.ui.view">
        <field name="name">flight.crew.tree</field>
        <field name="model">flight.crew</field>
        <field name="arch" type="xml">
            <tree>
                <field name="partner_id" />
                <field name="role_id" />
                <field name="flight_id" />
            </tree>
        </field>
    </record>

    <record id="view_flight_crew_form" model="ir.ui.view">
        <field name="name">flight.crew.form</field>
        <field name="model">flight.crew</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Crew Member">
                            <field name="partner_id" domain="[('is_company', '=', False)]" />
                        </group>
                        <group string="Assignment">
                            <field name="role_id" />
                            <field name="flight_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Flight Crew Role Views -->
    <record id="view_flight_crew_role_tree" model="ir.ui.view">
        <field name="name">flight.crew.role.tree</field>
        <field name="model">flight.crew.role</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="view_flight_crew_role_form" model="ir.ui.view">
        <field name="name">flight.crew.role.form</field>
        <field name="model">flight.crew.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action windows -->
    <record id="action_flight_crew" model="ir.actions.act_window">
        <field name="name">Flight Crew</field>
        <field name="res_model">flight.crew</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_flight_crew_role" model="ir.actions.act_window">
        <field name="name">Crew Roles</field>
        <field name="res_model">flight.crew.role</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
