<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Flight Crew Assignment Views -->
    <record id="view_flight_flight_crew_tree" model="ir.ui.view">
        <field name="name">flight.flight.crew.list</field>
        <field name="model">flight.flight.crew</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id" />
                <field name="flight_id" />
            </list>
        </field>
    </record>

    <record id="view_flight_flight_crew_form" model="ir.ui.view">
        <field name="name">flight.flight.crew.form</field>
        <field name="model">flight.flight.crew</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Crew Member">
                            <field
                name="partner_id"
                domain="[('is_company', '=', False)]"
              />
                        </group>
                        <group string="Assignment">
                            <field name="flight_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action windows -->
    <record id="action_flight_crew" model="ir.actions.act_window">
        <field name="name">Crew Assignments</field>
        <field name="res_model">flight.flight.crew</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
