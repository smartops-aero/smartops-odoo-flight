<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="flight_event_view_flight_form" model="ir.ui.view">
        <field name="name">flight.ops.flight.form</field>
        <field name="model">flight.flight</field>
        <field name="inherit_id" ref="flight.view_flight_form" />
        <field name="arch" type="xml">
            <sheet position="inside">
                <notebook>
                    <page string="Times">
                        <field
              name="event_time_ids"
              widget="flight_event_time_matrix"
              options="{'time_kinds': 'get_time_kinds'}"
            >
                            <list>
                                <field name="flight_id" />
                                <field name="time_kind" />
                                <field name="code_id" />
                                <field name="time" />
                            </list>
                        </field>
                    </page>
                    <page string="Phase Durations">
                        <field name="phase_duration_ids">
                            <list>
                                <field name="phase_id" />
                                <field name="time_kind" />
                                <field name="start_event_id" />
                                <field name="end_event_id" />
                                <field name="duration" widget="float_time" />
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

    <record
    id="action_create_missing_flight_durations"
    model="ir.actions.server"
  >
        <field name="name">Create Missing Flight Durations</field>
        <field name="model_id" ref="model_flight_flight" />
        <field name="binding_model_id" ref="model_flight_flight" />
        <field name="state">code</field>
        <field name="code">
            records.create_missing_phase_durations()
        </field>
    </record>


    <record id="view_flight_tree_inherited" model="ir.ui.view">
        <field name="name">flight.flight.tree.inherited</field>
        <field name="model">flight.flight</field>
        <field name="inherit_id" ref="flight.view_flight_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="block_duration" widget="float_time" />
                <field name="flight_duration" widget="float_time" />
            </xpath>
            <xpath expr="//tree" position="inside">
                <header>
                    <button
            name="%(action_create_missing_flight_durations)d"
            type="action"
            string="Create Missing Durations"
            class="btn-primary"
          />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
