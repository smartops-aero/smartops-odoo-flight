<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Flight Pilot Time Code Views -->
    <record id="view_flight_pilot_time_code_tree" model="ir.ui.view">
        <field name="name">flight.pilot.time.code.tree</field>
        <field name="model">flight.pilot.time.code</field>
        <field name="arch" type="xml">
            <tree string="Time Codes">
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
                <field name="description" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <record id="view_flight_pilot_time_code_form" model="ir.ui.view">
        <field name="name">flight.pilot.time.code.form</field>
        <field name="model">flight.pilot.time.code</field>
        <field name="arch" type="xml">
            <form string="Time Code">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
              name="toggle_active"
              type="object"
              class="oe_stat_button"
              icon="fa-archive"
            >
                            <field name="active" widget="boolean_button" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="name" />
                            <field name="sequence" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field
                name="description"
                nolabel="1"
                placeholder="Detailed description of this time code..."
              />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_flight_pilot_time_code_search" model="ir.ui.view">
        <field name="name">flight.pilot.time.code.search</field>
        <field name="model">flight.pilot.time.code</field>
        <field name="arch" type="xml">
            <search string="Search Time Codes">
                <field name="name" />
                <field name="code" />
                <field name="description" />
                <filter
          string="Archived"
          name="inactive"
          domain="[('active', '=', False)]"
        />
            </search>
        </field>
    </record>

    <record
    id="action_flight_pilot_time_code_list"
    model="ir.actions.act_window"
  >
        <field name="name">Time Codes</field>
        <field name="res_model">flight.pilot.time.code</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first time code
            </p>
            <p>
                Time codes are used to categorize pilot flight times.
            </p>
        </field>
    </record>
</odoo>
