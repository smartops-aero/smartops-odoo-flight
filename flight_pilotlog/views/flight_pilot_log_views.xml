<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flight_pilot_log_form" model="ir.ui.view">
        <field name="name">flight.pilot.log.editor.form</field>
        <field name="model">flight.pilot.log.editor</field>
        <field name="arch" type="xml">
            <form string="Pilot Log Editor">
                <sheet>
                    <group>
                        <group>
                            <field name="flight_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="date"/>
                            <field name="departure_id"/>
                            <field name="arrival_id"/>
                            <field name="aircraft_id"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Flight Time" name="flight_time">
                            <group>
                                <group string="Required Times">
                                    <field name="pic_duration"/>
                                    <field name="sic_duration"/>
                                </group>
                                <group string="Optional Times" name="optional_times">
                                    <field name="dual_duration" optional="show"/>
                                    <field name="picus_duration" optional="show"/>
                                    <field name="instructor_duration" optional="hide"/>
                                    <field name="examiner_duration" optional="hide"/>
                                    <field name="night_duration" optional="show"/>
                                    <field name="xc_duration" optional="hide"/>
                                    <field name="ifr_duration" optional="hide"/>
                                    <field name="hood_duration" optional="hide"/>
                                    <field name="imc_duration" optional="hide"/>
                                    <field name="relief_duration" optional="hide"/>
                                    <field name="safety_duration" optional="hide"/>
                                    <field name="air_duration" optional="show"/>
                                    <field name="total_duration" optional="show"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Events" name="events">
                            <group>
                                <field name="to_day_count"/>
                                <field name="to_night_count"/>
                                <field name="ldg_day_count"/>
                                <field name="ldg_night_count"/>
                                <field name="lift_count"/>
                                <field name="holding_count"/>
                            </group>
                        </page>
                        
                        <page string="Remarks" name="remarks">
                            <field name="remark" placeholder="Enter any remarks about this flight..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_flight_pilot_log_tree" model="ir.ui.view">
        <field name="name">flight.pilot.log.editor.tree</field>
        <field name="model">flight.pilot.log.editor</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="flight_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="departure_id"/>
                <field name="arrival_id"/>
                <field name="pic_duration" sum="Total PIC"/>
                <field name="sic_duration" sum="Total SIC"/>
                <field name="dual_duration" optional="hide" sum="Total Dual"/>
                <field name="picus_duration" optional="hide" sum="Total PICUS"/>
                <field name="instructor_duration" optional="hide" sum="Total Instructor"/>
                <field name="examiner_duration" optional="hide" sum="Total Examiner"/>
                <field name="night_duration" optional="hide" sum="Total Night"/>
                <field name="xc_duration" optional="hide" sum="Total XC"/>
                <field name="ifr_duration" optional="hide" sum="Total IFR"/>
                <field name="hood_duration" optional="hide" sum="Total Hood"/>
                <field name="imc_duration" optional="hide" sum="Total IMC"/>
                <field name="relief_duration" optional="hide" sum="Total Relief"/>
                <field name="safety_duration" optional="hide" sum="Total Safety"/>
                <field name="air_duration" optional="hide" sum="Total Air"/>
                <field name="total_duration" optional="show" sum="Total Time"/>
                <field name="to_day_count" optional="hide" sum="Total Day Takeoffs"/>
                <field name="to_night_count" optional="hide" sum="Total Night Takeoffs"/>
                <field name="ldg_day_count" optional="hide" sum="Total Day Landings"/>
                <field name="ldg_night_count" optional="hide" sum="Total Night Landings"/>
                <field name="lift_count" optional="hide" sum="Total Lifts"/>
                <field name="holding_count" optional="hide" sum="Total Holdings"/>
            </tree>
        </field>
    </record>

    <!-- Action for viewing pilot logs -->
    <record id="action_flight_pilot_log" model="ir.actions.act_window">
        <field name="name">Pilot Log Overview</field>
        <field name="res_model">flight.pilot.log.editor</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
        <field name="context">{'create': False}</field>
    </record>
    
    <!-- Server action to load pilot logs -->
    <record id="action_load_pilot_logs" model="ir.actions.server">
        <field name="name">Pilot Log Overview</field>
        <field name="model_id" ref="model_flight_pilot_log_editor"/>
        <field name="state">code</field>
        <field name="code">action = model.load_pilot_logs()</field>
    </record>
</odoo>
