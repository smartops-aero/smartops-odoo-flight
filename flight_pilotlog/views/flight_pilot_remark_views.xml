<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Flight Pilot Remark Views -->
    <record id="view_flight_pilot_remark_tree" model="ir.ui.view">
        <field name="name">flight.pilot.remark.tree</field>
        <field name="model">flight.pilot.remark</field>
        <field name="arch" type="xml">
            <tree string="Pilot Remarks">
                <field name="flight_id" />
                <field name="partner_id" />
                <field name="date" />
            </tree>
        </field>
    </record>

    <record id="view_flight_pilot_remark_form" model="ir.ui.view">
        <field name="name">flight.pilot.remark.form</field>
        <field name="model">flight.pilot.remark</field>
        <field name="arch" type="xml">
            <form string="Pilot Remark">
                <sheet>
                    <group>
                        <group>
                            <field name="flight_id" />
                            <field name="partner_id" />
                            <field name="date" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Remark">
                            <field
                name="remark"
                nolabel="1"
                placeholder="Enter pilot remarks about the flight..."
              />
                        </page>
                        <page
              string="Signature"
              attrs="{'invisible': [('signature', '=', False)]}"
            >
                            <field
                name="signature"
                widget="image"
                class="oe_avatar"
              />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_flight_pilot_remark_search" model="ir.ui.view">
        <field name="name">flight.pilot.remark.search</field>
        <field name="model">flight.pilot.remark</field>
        <field name="arch" type="xml">
            <search string="Search Pilot Remarks">
                <field name="flight_id" />
                <field name="partner_id" />
                <field name="date" />
                <filter
          string="This Month"
          name="this_month"
          domain="[('date','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),('date','&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"
        />
                <filter
          string="This Year"
          name="this_year"
          domain="[('date','&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d')),('date','&lt;=', (context_today() + relativedelta(years=1, month=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"
        />
                <group expand="0" string="Group By">
                    <filter
            string="Flight"
            name="group_by_flight"
            domain="[]"
            context="{'group_by':'flight_id'}"
          />
                    <filter
            string="Pilot"
            name="group_by_pilot"
            domain="[]"
            context="{'group_by':'partner_id'}"
          />
                    <filter
            string="Date"
            name="group_by_date"
            domain="[]"
            context="{'group_by':'date'}"
          />
                </group>
            </search>
        </field>
    </record>

    <record id="action_flight_pilot_remark_list" model="ir.actions.act_window">
        <field name="name">Pilot Remarks</field>
        <field name="res_model">flight.pilot.remark</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first pilot remark
            </p>
            <p>
                Pilot remarks capture notes and signatures for flights.
            </p>
        </field>
    </record>
</odoo>
