<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit Aircraft Form View -->
    <record id="view_flight_aircraft_form_inherit_spec" model="ir.ui.view">
        <field name="name">flight.aircraft.form.inherit.spec</field>
        <field name="model">flight.aircraft</field>
        <field name="inherit_id" ref="flight.view_flight_aircraft_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Specifications" name="specifications">
                    <field
            name="spec_ids"
            context="{'default_aircraft_id': id}"
          >
                        <list
              editable="bottom"
              create="true"
              delete="true"
              decoration-muted="code_type == False"
            >
                            <field name="sequence" widget="handle" />
                            <field
                name="code_id"
                required="1"
                domain="[('code_type', '!=', False)]"
              />
                            <field name="display_name" readonly="1" />
                            <field
                name="value_bool"
                invisible="code_type != 'bool'"
                required="code_type == 'bool'"
              />
                            <field
                name="value_text"
                invisible="code_type != 'text'"
                required="code_type == 'text'"
              />
                            <field
                name="value_float"
                invisible="code_type != 'float'"
                required="code_type == 'float'"
              />
                            <field
                name="uom_id"
                invisible="code_type != 'float'"
              />
                        </list>
                    </field>
                </page>
                <page string="Images" name="images">
                    <group>
                        <field
              name="seat_map_1920"
              widget="image"
              string="Seat Map (1920)"
            />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
