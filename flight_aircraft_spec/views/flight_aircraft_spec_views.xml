<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Category Views -->
    <record id="view_flight_aircraft_spec_category_tree" model="ir.ui.view">
        <field name="name">flight.aircraft.spec.category.tree</field>
        <field name="model">flight.aircraft.spec.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="view_flight_aircraft_spec_category_form" model="ir.ui.view">
        <field name="name">flight.aircraft.spec.category.form</field>
        <field name="model">flight.aircraft.spec.category</field>
        <field name="arch" type="xml">
            <form string="Aircraft Specification Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                        </group>
                        <group>
                            <field name="sequence" />
                        </group>
                    </group>
                    <group>
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Specification Code Views -->
    <record id="view_flight_aircraft_spec_code_tree" model="ir.ui.view">
        <field name="name">flight.aircraft.spec.code.tree</field>
        <field name="model">flight.aircraft.spec.code</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="category_id" />
                <field name="name" />
                <field name="code" />
                <field name="code_type" />
                <field name="description" />
                <field name="default_uom_id" />
            </tree>
        </field>
    </record>

    <record id="view_flight_aircraft_spec_code_form" model="ir.ui.view">
        <field name="name">flight.aircraft.spec.code.form</field>
        <field name="model">flight.aircraft.spec.code</field>
        <field name="arch" type="xml">
            <form string="Aircraft Specification Code">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="category_id" />
                        </group>
                        <group>
                            <field name="code_type" />
                            <field name="sequence" />
                            <field
                name="default_uom_id"
                attrs="{'invisible': [('code_type', '!=', 'float')]}"
              />
                        </group>
                    </group>
                    <group>
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Specification Views -->
    <record id="view_flight_aircraft_spec_tree" model="ir.ui.view">
        <field name="name">flight.aircraft.spec.tree</field>
        <field name="model">flight.aircraft.spec</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="aircraft_id" />
                <field name="code_id" />
                <field name="display_name" />
            </tree>
        </field>
    </record>

    <record id="view_flight_aircraft_spec_form" model="ir.ui.view">
        <field name="name">flight.aircraft.spec.form</field>
        <field name="model">flight.aircraft.spec</field>
        <field name="arch" type="xml">
            <form string="Aircraft Specification">
                <sheet>
                    <group>
                        <group>
                            <field name="aircraft_id" />
                            <field name="sequence" />
                            <field name="code_id" />
                            <field name="code_type" invisible="1" />
                        </group>
                        <group>
                            <field
                name="value_bool"
                attrs="{'invisible': [('code_type', '!=', 'bool')]}"
              />
                            <field
                name="value_text"
                attrs="{'invisible': [('code_type', '!=', 'text')]}"
              />
                            <field
                name="value_float"
                attrs="{'invisible': [('code_type', '!=', 'float')]}"
              />
                            <field
                name="uom_id"
                attrs="{'invisible': [('code_type', '!=', 'float')]}"
              />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record
    id="action_flight_aircraft_spec_category"
    model="ir.actions.act_window"
  >
        <field name="name">Specification Categories</field>
        <field name="res_model">flight.aircraft.spec.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_flight_aircraft_spec_code" model="ir.actions.act_window">
        <field name="name">Specification Codes</field>
        <field name="res_model">flight.aircraft.spec.code</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_flight_aircraft_spec" model="ir.actions.act_window">
        <field name="name">Aircraft Specifications</field>
        <field name="res_model">flight.aircraft.spec</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>
