<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Categories -->
        <record id="category_amenity" model="flight.aircraft.spec.category">
            <field name="name">Amenities</field>
            <field name="code">amenity</field>
            <field name="sequence">10</field>
            <field name="description">Aircraft amenities and features</field>
        </record>

        <record id="category_cabin" model="flight.aircraft.spec.category">
            <field name="name">Cabin</field>
            <field name="code">cabin</field>
            <field name="sequence">20</field>
            <field name="description">Cabin specifications and measurements</field>
        </record>

        <record id="category_capacity" model="flight.aircraft.spec.category">
            <field name="name">Capacity</field>
            <field name="code">capacity</field>
            <field name="sequence">30</field>
            <field name="description">Passenger and cargo capacity</field>  
        </record>

        <record id="category_performance" model="flight.aircraft.spec.category">
            <field name="name">Performance</field>
            <field name="code">performance</field>
            <field name="sequence">40</field>
            <field name="description">Aircraft performance characteristics</field>
        </record>

        <!-- Specification Codes -->
        <record id="spec_wifi" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_amenity"/>
            <field name="code">amenity.wifi</field>
            <field name="name">Starlink WiFi</field>
            <field name="description">Aircraft is equipped with Starlink WiFi</field>
            <field name="code_type">bool</field>
            <field name="sequence">10</field>
        </record>

        <record id="spec_power" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_amenity"/>
            <field name="code">amenity.power</field>
            <field name="name">Power Outlets</field>
            <field name="description">Aircraft is equipped with power outlets</field>
            <field name="code_type">bool</field>
            <field name="sequence">20</field>
        </record>

        <record id="spec_quiet_cabin" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_amenity"/>
            <field name="code">amenity.quiet_cabin</field>
            <field name="name">Quiet Cabin</field>
            <field name="description">Aircraft features a quiet cabin</field>
            <field name="code_type">bool</field>
            <field name="sequence">30</field>
        </record>

        <record id="spec_lavatory" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_amenity"/>
            <field name="code">amenity.lavatory</field>
            <field name="name">Enclosed Aft Lavatory</field>
            <field name="description">Aircraft features an enclosed aft lavatory</field>
            <field name="code_type">bool</field>
            <field name="sequence">40</field>
        </record>

        <record id="spec_air_conditioning" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_amenity"/>
            <field name="code">amenity.air_conditioning</field>
            <field name="name">Air Conditioning</field>
            <field name="description">Aircraft is equipped with air conditioning</field>
            <field name="code_type">bool</field>
            <field name="sequence">50</field>
        </record>

        <record id="spec_leather_seats" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_amenity"/>
            <field name="code">amenity.leather_seats</field>
            <field name="name">Leather Seats</field>
            <field name="description">Aircraft features leather seats</field>
            <field name="code_type">bool</field>
            <field name="sequence">60</field>
        </record>

        <record id="spec_entertainment" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_amenity"/>
            <field name="code">amenity.entertainment</field>
            <field name="name">Entertainment System</field>
            <field name="description">Aircraft is equipped with an entertainment system</field>
            <field name="code_type">bool</field>
            <field name="sequence">70</field>
        </record>

        <record id="spec_refreshments" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_amenity"/>
            <field name="code">amenity.refreshments</field>
            <field name="name">Refreshment Center</field>
            <field name="description">Aircraft features a refreshment center</field>
            <field name="code_type">bool</field>
            <field name="sequence">80</field>
        </record>

        <record id="spec_cargo_door" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_amenity"/>
            <field name="code">amenity.cargo_door</field>
            <field name="name">Cargo Door</field>
            <field name="description">Aircraft features a cargo door</field>
            <field name="code_type">bool</field>
            <field name="sequence">90</field>
        </record>

        <record id="spec_ice_maker" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_amenity"/>
            <field name="code">amenity.ice_maker</field>
            <field name="name">Ice Maker</field>
            <field name="description">Aircraft is equipped with an ice maker</field>
            <field name="code_type">bool</field>
            <field name="sequence">100</field>
        </record>

        <record id="spec_ice_drawer" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_amenity"/>
            <field name="code">amenity.ice_drawer</field>
            <field name="name">Ice Drawer</field>
            <field name="description">Aircraft features an ice storage drawer</field>
            <field name="code_type">bool</field>
            <field name="sequence">110</field>
        </record>

        <record id="spec_microwave_oven" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_amenity"/>
            <field name="code">amenity.microwave_oven</field>
            <field name="name">Microwave &amp; Oven</field>
            <field name="description">Aircraft is equipped with a microwave and oven combination</field>
            <field name="code_type">bool</field>
            <field name="sequence">120</field>
        </record>

        <!-- Cabin Specifications -->
        <record id="spec_cabin_length" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_cabin"/>
            <field name="code">cabin.length</field>
            <field name="name">Cabin Length</field>
            <field name="description">Length of the aircraft cabin</field>
            <field name="code_type">float</field>
            <field name="sequence">10</field>
            <field name="default_uom_id" ref="uom.product_uom_foot"/>
        </record>

        <record id="spec_cabin_width" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_cabin"/>
            <field name="code">cabin.width</field>
            <field name="name">Cabin Width</field>
            <field name="description">Width of the aircraft cabin</field>
            <field name="code_type">float</field>
            <field name="sequence">20</field>
            <field name="default_uom_id" ref="uom.product_uom_foot"/>
        </record>

        <record id="spec_cabin_height" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_cabin"/>
            <field name="code">cabin.height</field>
            <field name="name">Cabin Height</field>
            <field name="description">Height of the aircraft cabin</field>
            <field name="code_type">float</field>
            <field name="sequence">30</field>
            <field name="default_uom_id" ref="uom.product_uom_foot"/>
        </record>

        <!-- Performance Specifications -->
        <record id="spec_range" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_performance"/>
            <field name="code">performance.range</field>
            <field name="name">Range</field>
            <field name="description">Maximum flight range of the aircraft</field>
            <field name="code_type">float</field>
            <field name="sequence">10</field>
            <field name="default_uom_id" ref="flight_uom.product_uom_nm"/>
        </record>

        <record id="spec_cruise_speed" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_performance"/>
            <field name="code">performance.cruise_speed</field>
            <field name="name">Cruise Speed</field>
            <field name="description">Normal cruising speed of the aircraft</field>
            <field name="code_type">float</field>
            <field name="sequence">20</field>
            <field name="default_uom_id" ref="flight_uom.product_uom_kt"/>
        </record>

        <!-- Capacity Specifications -->
        <record id="spec_passenger_capacity" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_capacity"/>
            <field name="code">capacity.passengers</field>
            <field name="name">Passenger Capacity</field>
            <field name="description">Maximum number of passengers the aircraft can accommodate</field>
            <field name="code_type">float</field>
            <field name="sequence">10</field>
        </record>

        <record id="spec_luggage_capacity" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_capacity"/>
            <field name="code">capacity.luggage</field>
            <field name="name">Luggage Capacity</field>
            <field name="description">Maximum luggage volume capacity</field>
            <field name="code_type">float</field>
            <field name="sequence">20</field>
            <field name="default_uom_id" ref="uom.product_uom_cubic_meter"/>
        </record>

        <record id="spec_useful_load" model="flight.aircraft.spec.code">
            <field name="category_id" ref="category_capacity"/>
            <field name="code">capacity.useful_load</field>
            <field name="name">Useful Load</field>
            <field name="description">Maximum useful load capacity including passengers, cargo, and fuel</field>
            <field name="code_type">float</field>
            <field name="sequence">30</field>
            <field name="default_uom_id" ref="uom.product_uom_lb"/>
        </record>
    </data>
</odoo>