<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CrewLounge Import Pipeline -->
    <record id="crewlounge_import_pipeline" model="base.import.pipeline">
        <field name="name">CrewLounge Flight Import</field>
        <field name="model_id" ref="flight.model_flight_flight"/>
        <field name="implementation">crewlounge</field>
        <field name="active" eval="True"/>
    </record>
    
    <!-- Field Mappings -->
    <record id="mapping_flight_date" model="base.import.pipeline.mapping">
        <field name="pipeline_id" ref="crewlounge_import_pipeline"/>
        <field name="description">Flight Date</field>
        <field name="source_field">PILOTLOG_DATE</field>
        <field name="target_field">date</field>
        <field name="model_id" ref="flight.model_flight_flight"/>
        <field name="transformation">date_format</field>
        <field name="sequence">10</field>
        <field name="is_key_field" eval="True"/>
    </record>
    
    <!-- Aircraft Make -->
    <record id="mapping_aircraft_make" model="base.import.pipeline.mapping">
        <field name="pipeline_id" ref="crewlounge_import_pipeline"/>
        <field name="description">Aircraft Make</field>
        <field name="source_field">AC_MAKE</field>
        <field name="target_field">name</field>
        <field name="model_id" ref="flight.model_flight_aircraft_make"/>
        <field name="transformation">direct</field>
        <field name="sequence">20</field>
        <field name="is_key_field" eval="True"/>
    </record>
    
    <!-- Aircraft Model -->
    <record id="mapping_aircraft_model" model="base.import.pipeline.mapping">
        <field name="pipeline_id" ref="crewlounge_import_pipeline"/>
        <field name="description">Aircraft Model</field>
        <field name="source_field">AC_MODEL</field>
        <field name="target_field">name</field>
        <field name="model_id" ref="flight.model_flight_aircraft_model"/>
        <field name="transformation">direct</field>
        <field name="sequence">30</field>
        <field name="is_key_field" eval="True"/>
    </record>
    
    <!-- Link Aircraft Model to Make -->
    <record id="mapping_aircraft_model_make" model="base.import.pipeline.mapping">
        <field name="pipeline_id" ref="crewlounge_import_pipeline"/>
        <field name="description">Aircraft Model Make</field>
        <field name="source_field">AC_MAKE</field>
        <field name="target_field">make_id</field>
        <field name="model_id" ref="flight.model_flight_aircraft_model"/>
        <field name="transformation">lookup</field>
        <field name="relation_model_id" ref="flight.model_flight_aircraft_make"/>
        <field name="relation_field">name</field>
        <field name="sequence">31</field>
    </record>
    
    <!-- Aircraft Registration -->
    <record id="mapping_aircraft_registration" model="base.import.pipeline.mapping">
        <field name="pipeline_id" ref="crewlounge_import_pipeline"/>
        <field name="description">Aircraft Registration</field>
        <field name="source_field">AC_REG</field>
        <field name="target_field">registration</field>
        <field name="model_id" ref="flight.model_flight_aircraft"/>
        <field name="transformation">direct</field>
        <field name="sequence">40</field>
        <field name="is_key_field" eval="True"/>
    </record>
    
    <!-- Link Aircraft to Model -->
    <record id="mapping_aircraft_model_link" model="base.import.pipeline.mapping">
        <field name="pipeline_id" ref="crewlounge_import_pipeline"/>
        <field name="description">Aircraft Model Link</field>
        <field name="source_field">AC_MODEL</field>
        <field name="target_field">model_id</field>
        <field name="model_id" ref="flight.model_flight_aircraft"/>
        <field name="transformation">lookup</field>
        <field name="relation_model_id" ref="flight.model_flight_aircraft_model"/>
        <field name="relation_field">name</field>
        <field name="sequence">41</field>
    </record>
    
    <!-- Departure Aerodrome -->
    <record id="mapping_departure_aerodrome" model="base.import.pipeline.mapping">
        <field name="pipeline_id" ref="crewlounge_import_pipeline"/>
        <field name="description">Departure Aerodrome</field>
        <field name="source_field">AF_DEP</field>
        <field name="target_field">departure_id</field>
        <field name="model_id" ref="flight.model_flight_flight"/>
        <field name="transformation">lookup</field>
        <field name="relation_model_id" ref="flight.model_flight_aerodrome"/>
        <field name="relation_field">icao</field>
        <field name="lookup_fields">iata,name</field>
        <field name="sequence">50</field>
        <field name="is_key_field" eval="True"/>
    </record>
    
    <!-- Arrival Aerodrome -->
    <record id="mapping_arrival_aerodrome" model="base.import.pipeline.mapping">
        <field name="pipeline_id" ref="crewlounge_import_pipeline"/>
        <field name="description">Arrival Aerodrome</field>
        <field name="source_field">AF_ARR</field>
        <field name="target_field">arrival_id</field>
        <field name="model_id" ref="flight.model_flight_flight"/>
        <field name="transformation">lookup</field>
        <field name="relation_model_id" ref="flight.model_flight_aerodrome"/>
        <field name="relation_field">icao</field>
        <field name="lookup_fields">iata,name</field>
        <field name="sequence">60</field>
        <field name="is_key_field" eval="True"/>
    </record>
    
    <!-- Flight Aircraft -->
    <record id="mapping_flight_aircraft" model="base.import.pipeline.mapping">
        <field name="pipeline_id" ref="crewlounge_import_pipeline"/>
        <field name="description">Flight Aircraft</field>
        <field name="source_field">AC_REG</field>
        <field name="target_field">aircraft_id</field>
        <field name="model_id" ref="flight.model_flight_flight"/>
        <field name="transformation">lookup</field>
        <field name="relation_model_id" ref="flight.model_flight_aircraft"/>
        <field name="relation_field">registration</field>
        <field name="sequence">70</field>
        <field name="is_key_field" eval="True"/>
    </record>
</odoo>
