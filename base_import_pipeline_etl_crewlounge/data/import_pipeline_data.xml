        <field name="relation_field">registration</field>
        <field name="sequence">70</field>
        <field name="is_key_field" eval="True"/>
    </record>
    
    <!-- POST-PROCESSING MAPPINGS -->
    
    <!-- Pilot Remark - Link to Flight (Parent Record) -->
