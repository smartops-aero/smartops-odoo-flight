<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CrewLounge Import Wizard Form View - Upload State -->
    <record id="view_crewlounge_import_wizard_form_upload" model="ir.ui.view">
        <field name="name">crewlounge.import.wizard.form.upload</field>
        <field name="model">crewlounge.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import CrewLounge CSV">
                <field name="state" invisible="1"/>
                <sheet>
                    <group attrs="{'invisible': [('state', '=', 'preview')]}">
                        <field name="file" filename="filename" attrs="{'required': [('state', '=', 'upload')]}"/>
                        <field name="filename" invisible="1"/>
                        <field name="delimiter"/>
                        <field name="partner_id"/>
                    </group>
                    <div class="alert alert-info" role="alert" attrs="{'invisible': [('state', '=', 'preview')]}">
                        <p>This wizard will import flight data from a CrewLounge CSV file.</p>
                        <p>The CSV should contain the following columns:</p>
                        <ul>
                            <li>FLIGHTNUMBER - The flight number</li>
                            <li>AF_DEP - The departure aerodrome ICAO code</li>
                            <li>AF_ARR - The arrival aerodrome ICAO code</li>
                            <li>AC_REG - The aircraft registration</li>
                        </ul>
                    </div>
                    
                    <!-- Preview Section -->
                    <group attrs="{'invisible': [('state', '!=', 'preview')]}">
                        <field name="preview_data" widget="html" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Preview" name="action_preview" type="object" class="btn-primary" attrs="{'invisible': [('state', '=', 'preview')]}"/>
                    <button string="Import" name="action_import" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'preview')]}"/>
                    <button string="Back to Upload" name="action_back_to_upload" type="object" class="btn-secondary" attrs="{'invisible': [('state', '!=', 'preview')]}"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- CrewLounge Import Wizard Action -->
    <record id="action_crewlounge_import_wizard" model="ir.actions.act_window">
        <field name="name">Import CrewLounge CSV</field>
        <field name="res_model">crewlounge.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_crewlounge_import_wizard"
              name="Import CrewLounge CSV"
              parent="flight.menu_flight_root"
              action="action_crewlounge_import_wizard"
              sequence="50"/>
</odoo>
