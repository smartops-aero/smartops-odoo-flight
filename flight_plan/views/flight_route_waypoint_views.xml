<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Flight Route Waypoint List View -->
    <record id="view_flight_route_waypoint_tree" model="ir.ui.view">
        <field name="name">flight.route.waypoint.list</field>
        <field name="model">flight.route.waypoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" />
                <field name="name" />
                <field name="description" />
                <field name="latitude" />
                <field name="longitude" />
                <field name="icao_country_code" />
                <field name="route_id" />
            </list>
        </field>
    </record>

    <!-- Flight Route Waypoint Form View -->
    <record id="view_flight_route_waypoint_form" model="ir.ui.view">
        <field name="name">flight.route.waypoint.form</field>
        <field name="model">flight.route.waypoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" class="oe_button_box" />
                    <group>
                        <field name="route_id" />
                        <field name="sequence" />
                        <field name="name" />
                        <field name="description" />
                    </group>
                    <group string="Coordinates">
                        <field name="latitude" />
                        <field name="longitude" />
                        <field name="icao_country_code" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Flight Route Waypoint Search View -->
    <record id="view_flight_route_waypoint_search" model="ir.ui.view">
        <field name="name">flight.route.waypoint.search</field>
        <field name="model">flight.route.waypoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="description" />
                <field name="route_id" />
                <field name="icao_country_code" />
                <group expand="0" string="Group By">
                    <filter
                        string="Route"
                        name="group_by_route"
                        context="{'group_by': 'route_id'}"
                    />
                    <filter
                        string="Country"
                        name="group_by_country"
                        context="{'group_by': 'icao_country_code'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Flight Route Waypoint Action Window -->
    <record id="action_flight_route_waypoint_list" model="ir.actions.act_window">
        <field name="name">Flight Route Waypoints</field>
        <field name="res_model">flight.route.waypoint</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_flight_route_waypoint_search" />
    </record>
</odoo>