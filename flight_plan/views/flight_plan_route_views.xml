<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Flight Plan Route List View -->
    <record id="view_flight_plan_route_tree" model="ir.ui.view">
        <field name="name">flight.plan.route.list</field>
        <field name="model">flight.plan.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="fms_name" />
                <field name="route_type" />
                <field name="plan_id" />
            </list>
        </field>
    </record>

    <!-- Flight Plan Route Form View -->
    <record id="view_flight_plan_route_form" model="ir.ui.view">
        <field name="name">flight.plan.route.form</field>
        <field name="model">flight.plan.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" class="oe_button_box" />
                    <group>
                        <field name="name" />
                        <field name="fms_name" />
                        <field name="route_type" />
                        <field name="plan_id" />
                    </group>
                    <notebook>
                        <page string="Waypoints" name="waypoints">
                            <field name="waypoint_ids">
                                <list editable="bottom">
                                    <field name="sequence" />
                                    <field name="name" />
                                    <field name="description" />
                                    <field name="latitude" />
                                    <field name="longitude" />
                                    <field name="icao_country_code" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Flight Plan Route Search View -->
    <record id="view_flight_plan_route_search" model="ir.ui.view">
        <field name="name">flight.plan.route.search</field>
        <field name="model">flight.plan.route</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="fms_name" />
                <field name="route_type" />
                <field name="plan_id" />
                <filter
                    string="Flight Routes"
                    name="flight_routes"
                    domain="[('route_type', '=', 'flight')]"
                />
                <filter
                    string="Alternate Routes"
                    name="alternate_routes"
                    domain="[('route_type', '=', 'alternate')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Route Type"
                        name="group_by_route_type"
                        context="{'group_by': 'route_type'}"
                    />
                    <filter
                        string="Flight Plan"
                        name="group_by_plan"
                        context="{'group_by': 'plan_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Flight Plan Route Action Window -->
    <record id="action_flight_plan_route_list" model="ir.actions.act_window">
        <field name="name">Flight Routes</field>
        <field name="res_model">flight.plan.route</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_flight_plan_route_search" />
    </record>
</odoo>