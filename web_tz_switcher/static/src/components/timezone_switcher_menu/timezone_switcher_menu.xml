<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_tz_switcher.TimezoneSwitcherMenu">
        <Dropdown
            class="'o_timezone_switcher_menu'"
            menuClass="'o_timezone_switcher_dropdown'"
            togglerClass="'o_timezone_switcher_toggler'"
        >
            <t t-set-slot="toggler">
                <button
                    class="btn btn-secondary d-flex align-items-center gap-2"
                    title="Switch Display Timezone"
                >
                    <i t-att-class="'fa ' + iconClass" />
                    <span class="d-none d-lg-inline">
                        <t t-esc="currentTimezoneLabel" />
                    </span>
                    <t t-if="state.isOverride">
                        <span class="badge badge-warning ms-1">Override</span>
                    </t>
                </button>
            </t>

            <t t-set-slot="default">
                <div class="o_timezone_switcher_content">
                    <!-- Header with current timezone and time -->
                    <div class="dropdown-header p-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">Display Timezone</h6>
                            <span class="badge bg-primary">
                                <t t-esc="currentTimeFormatted" />
                            </span>
                        </div>
                        <div class="text-muted small">
                            Current: <strong><t t-esc="state.currentTimezone" /></strong>
                        </div>
                        <t t-if="state.isOverride">
                            <div class="mt-2">
                                <button
                                    class="btn btn-sm btn-warning w-100"
                                    t-on-click="onResetTimezone"
                                >
                                    <i class="fa fa-undo me-1" />
                                    Reset to Default
                                </button>
                            </div>
                        </t>
                    </div>

                    <!-- Search box -->
                    <div class="p-2 border-bottom">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">
                                <i class="fa fa-search" />
                            </span>
                            <input
                                type="text"
                                class="form-control"
                                placeholder="Search timezones..."
                                t-model="state.searchQuery"
                                t-on-input="onSearchInput"
                            />
                            <t t-if="state.searchQuery">
                                <button
                                    class="btn btn-outline-secondary"
                                    t-on-click="onClearSearch"
                                >
                                    <i class="fa fa-times" />
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Timezone list (grouped by region) -->
                    <div class="o_timezone_list overflow-auto" style="max-height: 400px;">
                        <t t-foreach="visibleRegions" t-as="region" t-key="region">
                            <div class="dropdown-header bg-light sticky-top">
                                <strong><t t-esc="region" /></strong>
                            </div>
                            <t
                                t-foreach="filteredGroupedTimezones[region]"
                                t-as="timezone"
                                t-key="timezone"
                            >
                                <DropdownItem
                                    class="'o_timezone_item'"
                                    onSelected="() => this.onTimezoneSelect(timezone)"
                                >
                                    <div class="d-flex justify-content-between align-items-center w-100">
                                        <span>
                                            <t t-esc="formatTimezoneName(timezone)" />
                                        </span>
                                        <span class="badge bg-secondary ms-2">
                                            <t t-esc="getTimezoneOffset(timezone)" />
                                        </span>
                                    </div>
                                    <t t-if="timezone === state.currentTimezone">
                                        <i class="fa fa-check text-success ms-2" />
                                    </t>
                                </DropdownItem>
                            </t>
                        </t>
                    </div>

                    <!-- Footer with toggle for all regions -->
                    <t t-if="!state.searchQuery and !state.showAllRegions">
                        <div class="dropdown-divider" />
                        <div class="p-2">
                            <button
                                class="btn btn-sm btn-link w-100 text-start"
                                t-on-click="onToggleAllRegions"
                            >
                                <i class="fa fa-globe me-1" />
                                Show All Regions
                            </button>
                        </div>
                    </t>

                    <!-- Info footer -->
                    <div class="dropdown-divider" />
                    <div class="dropdown-header text-muted small">
                        <i class="fa fa-info-circle me-1" />
                        All times in database remain in UTC
                    </div>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
